// ui/tabs/editor_tab.slint

import {
    LineEdit,
    ComboBox,
    ListView,
    ScrollView,
    StandardListView,
    TextEdit,
} from "std-widgets.slint";
import { CustomButton } from "../components/buttons.slint";
import {
    SectionTitle,
    PanelSection,
    FormRow,
} from "../components/common.slint";

export component EditorTab inherits HorizontalLayout {
    in-out property <length> sidebar_width: 440px;

    in-out property <string> editor_cff_dir: "";
    in-out property <string> editor_filter: "";
    in-out property <string> editor_active_category: "2D Gfx Items (0x07DC)";
    in-out property <[StandardListViewItem]> editor_entries: [];
    in-out property <int> editor_selected_idx: -1;
    in-out property <string> editor_field_id: "";
    in-out property <string> editor_field_val1: "";
    in-out property <string> editor_field_val2: "";

    callback browse_folder() -> string;
    callback load_editor_data(string, string);
    callback select_editor_entry(int);
    callback save_editor_entry(string, string, int, string, string, string);
    callback add_editor_entry(string, string);
    callback duplicate_editor_entry(string, string, int, string);

    spacing: 0px;

    // LEFT PANEL: BROWSER & LIST
    Rectangle {
        width: root.sidebar_width;
        background: #2b2d31;
        border-color: #1f2023;
        border-width: 1px;
        border-radius: 4px;

        VerticalLayout {
            padding: 12px;
            spacing: 10px;

            PanelSection {
                title: "Target Database";
                title-color: #f0b132;
                VerticalLayout {
                    spacing: 6px;
                    FormRow {
                        title: "CFF Dir:";
                        HorizontalLayout {
                            spacing: 4px;
                            LineEdit {
                                text <=> root.editor_cff_dir;
                                placeholder-text: "Select extracted CFF folder...";
                                height: 28px;
                                font-family: "Consolas";
                                font-size: 11px;
                            }

                            CustomButton {
                                text: "...";
                                compact: true;
                                width: 30px;
                                height: 28px;
                                clicked => {
                                    let f = root.browse_folder();
                                    if (f != "") {
                                        root.editor_cff_dir = f;
                                        root.load_editor_data(root.editor_cff_dir, root.editor_active_category);
                                    }
                                }
                            }
                        }
                    }

                    FormRow {
                        title: "Category:";
                        ComboBox {
                            model: ["2D Gfx Items (0x07DC)", "Spells Mapping (0x07E2)", "Localized Strings"];
                            current-value <=> root.editor_active_category;
                            height: 28px;
                            selected => {
                                root.load_editor_data(root.editor_cff_dir, root.editor_active_category);
                            }
                        }
                    }

                    FormRow {
                        title: "Filter:";
                        LineEdit {
                            text <=> root.editor_filter;
                            placeholder-text: "Search ID or name...";
                            height: 28px;
                            font-family: "Consolas";
                            font-size: 11px;
                            edited => { root.load_editor_data(root.editor_cff_dir, root.editor_active_category); }
                        }
                    }
                }
            }

            PanelSection {
                title: "Parsed Records (" + root.editor_entries.length + " entries)";
                VerticalLayout {
                    spacing: 8px;
                    vertical-stretch: 1;

                    // Quick Action Buttons
                    HorizontalLayout {
                        spacing: 6px;
                        CustomButton {
                            text: "+ Add Entry";
                            primary-color: #23a55a;
                            enabled: root.editor_cff_dir != "";
                            clicked => {
                                root.add_editor_entry(root.editor_cff_dir, root.editor_active_category);
                            }
                        }

                        CustomButton {
                            text: "Duplicate Selected";
                            primary-color: #e59535;
                            enabled: root.editor_selected_idx >= 0 && root.editor_cff_dir != "";
                            clicked => {
                                root.duplicate_editor_entry(
                                    root.editor_cff_dir,
                                    root.editor_active_category,
                                    root.editor_selected_idx,
                                    root.editor_field_id);
                            }
                        }
                    }

                    // Adaptive List View
                    Rectangle {
                        background: #111214;
                        border-color: #1f2023;
                        border-width: 1px;
                        border-radius: 4px;
                        vertical-stretch: 1;
                        clip: true;

                        ListView {
                            for item[index] in root.editor_entries: Rectangle {
                                height: 26px;
                                background: ta_ed.has-hover ? #393c41 : (root.editor_selected_idx == index ? #2c3e50 : (Math.mod(index, 2) == 0 ? #191919 : #1c1c1c));
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: item.text;
                                        color: root.editor_selected_idx == index ? #f0b132 : #dcddde;
                                        font-family: "Consolas";
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                ta_ed := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.editor_selected_idx = index;
                                        root.select_editor_entry(index);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // DRAGGABLE SPLITTER
    Rectangle {
        width: 8px;
        background: splitter-ta.has-hover ? #474747 : #181818;

        Rectangle {
            width: 2px;
            height: 24px;
            background: #808080;
            border-radius: 1px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        splitter-ta := TouchArea {
            mouse-cursor: col-resize;
            moved => {
                if self.pressed {
                    root.sidebar_width = (root.sidebar_width + self.mouse-x - self.pressed-x).clamp(340px, 680px);
                }
            }
        }
    }

    // RIGHT PANEL: FIXED COMPACT INSPECTOR
    Rectangle {
        horizontal-stretch: 1;
        background: #2b2d31;
        border-color: #1f2023;
        border-width: 1px;
        border-radius: 4px;
        clip: true;

        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            alignment: start;

            SectionTitle {
                text: "Entity Property & Mesh Linkage Inspector";
                text-color: #f0b132;
            }

            FormRow {
                title: "Record Key / ID:";
                label-width: 130px;
                LineEdit {
                    text <=> root.editor_field_id;
                    read-only: true;
                    font-family: "Consolas";
                    height: 28px;
                }
            }

            // ЕСЛИ ВЫБРАНЫ ТЕКСТЫ — МНОГОСТРОЧНЫЙ TEXTEDIT
            if root.editor_active_category == "Localized Strings": VerticalLayout {
                spacing: 4px;
                Text {
                    text: "Localized Text Content:";
                    font-size: 11px;
                    color: #dcddde;
                }

                TextEdit {
                    text <=> root.editor_field_val1;
                    font-family: "Consolas";
                    font-size: 12px;
                    height: 140px;
                    wrap: TextWrap.word-wrap;
                }
            }

            if root.editor_active_category != "Localized Strings": FormRow {
                title: root.editor_active_category == "2D Gfx Items (0x07DC)" ? "Mesh File (.msh):" : "Target / Scroll ID:";
                label-width: 130px;
                LineEdit {
                    text <=> root.editor_field_val1;
                    font-family: "Consolas";
                    height: 28px;
                }
            }

            FormRow {
                title: "Extra / Parameters:";
                label-width: 130px;
                LineEdit {
                    text <=> root.editor_field_val2;
                    font-family: "Consolas";
                    height: 28px;
                }
            }

            CustomButton {
                text: "Save Changes to Database Chunk (.dat)";
                enabled: root.editor_selected_idx >= 0 && root.editor_cff_dir != "";
                primary-color: #23a55a;
                height: 32px;
                clicked => {
                    root.save_editor_entry(
                        root.editor_cff_dir,
                        root.editor_active_category,
                        root.editor_selected_idx,
                        root.editor_field_id,
                        root.editor_field_val1,
                        root.editor_field_val2);
                }
            }

            Rectangle {
                height: 1px;
                background: #353535;
            }

            Text {
                text: "Quick Guide:\n" +
                    "• + Add Entry: Creates a brand new record with (Max ID + 1).\n" +
                    "• Duplicate: Clones properties of the currently selected item under a new ID.\n" +
                    "• 2D Gfx Items: Notice duplicate IDs are valid in SF1 (e.g. one for scroll inventory, one for spellbook).\n" +
                    "• Localized Strings: Edit quest and item text across all campaign languages.\n\n" +
                    "All modified chunks compile cleanly back into .CFF with verified DWORD alignment.";
                color: #808080;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
}
