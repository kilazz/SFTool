// ui/tabs/editor_tab.slint

import {
    LineEdit,
    ComboBox,
    ListView,
    ScrollView,
    StandardListView,
    TextEdit,
    SpinBox,
} from "std-widgets.slint";
import { CustomButton } from "../components/buttons.slint";
import {
    SectionTitle,
    PanelSection,
    FormRow,
} from "../components/common.slint";

export component EditorTab inherits HorizontalLayout {
    in-out property <length> sidebar_width: 460px;

    in-out property <string> editor_cff_dir: "";
    in-out property <string> editor_asset_source: "";
    in-out property <string> editor_filter: "";
    in-out property <string> editor_active_category: "2D Gfx Items (0x07DC)";
    in-out property <[string]> available_categories: [
        "2D Gfx Items (0x07DC)",
        "Spells Mapping (0x07E2)",
        "Weapon Stats (0x07DF)",
        "Units Master (0x07E8)",
        "Unit Loot Tables (0x07F8)",
        "Localized Strings"
    ];
    in-out property <string> editor_lang_filter: "All Languages";
    in-out property <[string]> available_languages: [
        "All Languages",
        "Slot 0: German [DE]",
        "Slot 1: English [EN]",
        "Slot 2: French [FR]",
        "Slot 3: Spanish [ES]",
        "Slot 4: Italian [IT]"
    ];
    in-out property <[StandardListViewItem]> editor_entries: [];
    in-out property <int> editor_selected_idx: -1;
    in-out property <string> editor_field_id: "";
    in-out property <string> editor_field_val1: "";
    in-out property <string> editor_field_val2: "";

    // Visual Previews & Dual Cards
    in-out property <image> preview_icon1;
    in-out property <image> preview_icon2;
    in-out property <string> spell_name_disp: "";
    in-out property <string> scroll_name_disp: "";
    in-out property <string> asset_status_text: "Select a record to preview asset.";

    // History Undo/Redo State
    in-out property <bool> can_undo: false;
    in-out property <bool> can_redo: false;

    // Clone Wizard Input State
    in-out property <int> clone_src_slot: 1;
    in-out property <int> clone_dst_slot: 6;
    in-out property <string> clone_lang_tag: "AR";

    callback browse_folder() -> string;
    callback browse_file(string) -> string;
    callback save_file(string) -> string;

    callback load_editor_data(string, string, string, string);
    callback select_editor_entry(int);
    callback save_editor_entry(string, string, int, string, string, string);
    callback add_editor_entry(string, string);
    callback duplicate_editor_entry(string, string, int, string);
    callback delete_editor_entry(string, string, int, string);

    // History Callbacks (Undo / Redo)
    callback editor_undo();
    callback editor_redo();

    // Unified Multi-Language Callbacks
    callback export_single_language(string, string, string);
    callback import_language_to_slot(string, string, string);
    callback execute_clone_language(string, int, int, string, string);

    spacing: 0px;

    // MODAL CLONE LANGUAGE POPUP
    clone_popup := PopupWindow {
        width: 380px;
        height: 250px;
        close-policy: close-on-click-outside;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        Rectangle {
            background: #232529;
            border-color: #f0b132;
            border-width: 1.5px;
            border-radius: 6px;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                Text {
                    text: "Clone Language Slot (One-Click Wizard)";
                    font-size: 13px;
                    font-weight: 700;
                    color: #ffffff;
                }

                Rectangle {
                    height: 1px;
                    background: #353535;
                }

                FormRow {
                    title: "Source Slot:";
                    label-width: 100px;
                    SpinBox {
                        value <=> root.clone_src_slot;
                        minimum: 0;
                        maximum: 4;
                        height: 28px;
                    }
                }

                FormRow {
                    title: "New Slot ID:";
                    label-width: 100px;
                    SpinBox {
                        value <=> root.clone_dst_slot;
                        minimum: 5;
                        maximum: 255;
                        height: 28px;
                    }
                }

                FormRow {
                    title: "Language Tag:";
                    label-width: 100px;
                    LineEdit {
                        text <=> root.clone_lang_tag;
                        placeholder-text: "e.g. AR, TH, RU, PL, ZH";
                        font-family: "Consolas";
                        height: 28px;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    CustomButton {
                        text: "Cancel";
                        primary-color: #4e5058;
                        clicked => { clone_popup.close(); }
                    }

                    CustomButton {
                        text: "Clone & Export JSON";
                        primary-color: #23a55a;
                        clicked => {
                            let out_json = root.save_file("json");
                            if (out_json != "") {
                                root.execute_clone_language(
                                    root.editor_cff_dir,
                                    root.clone_src_slot,
                                    root.clone_dst_slot,
                                    root.clone_lang_tag,
                                    out_json);
                                clone_popup.close();
                            }
                        }
                    }
                }
            }
        }
    }

    // LEFT PANEL: BROWSER & LIST
    Rectangle {
        width: root.sidebar_width;
        background: #2b2d31;
        border-color: #1f2023;
        border-width: 1px;
        border-radius: 4px;

        VerticalLayout {
            padding: 12px;
            spacing: 10px;

            PanelSection {
                title: "Target Database & Active Scope";
                title-color: #f0b132;
                VerticalLayout {
                    spacing: 6px;
                    FormRow {
                        title: "CFF Dir:";
                        HorizontalLayout {
                            spacing: 4px;
                            LineEdit {
                                text <=> root.editor_cff_dir;
                                placeholder-text: "Select extracted CFF folder...";
                                height: 28px;
                                font-family: "Consolas";
                                font-size: 11px;
                            }

                            CustomButton {
                                text: "...";
                                compact: true;
                                width: 30px;
                                height: 28px;
                                clicked => {
                                    let f = root.browse_folder();
                                    if (f != "") {
                                        root.editor_cff_dir = f;
                                        root.load_editor_data(root.editor_cff_dir, root.editor_active_category, root.editor_filter, root.editor_lang_filter);
                                    }
                                }
                            }
                        }
                    }

                    FormRow {
                        title: "Asset Source:";
                        HorizontalLayout {
                            spacing: 4px;
                            LineEdit {
                                text <=> root.editor_asset_source;
                                placeholder-text: "Optional: .pak file or textures folder...";
                                height: 28px;
                                font-family: "Consolas";
                                font-size: 11px;
                            }

                            CustomButton {
                                text: "📁";
                                compact: true;
                                width: 28px;
                                height: 28px;
                                clicked => {
                                    let f = root.browse_folder();
                                    if (f != "") {
                                        root.editor_asset_source = f;
                                        root.load_editor_data(root.editor_cff_dir, root.editor_active_category, root.editor_filter, root.editor_lang_filter);
                                    }
                                }
                            }

                            CustomButton {
                                text: "📦";
                                compact: true;
                                width: 28px;
                                height: 28px;
                                clicked => {
                                    let f = root.browse_file("pak");
                                    if (f != "") {
                                        root.editor_asset_source = f;
                                        root.load_editor_data(root.editor_cff_dir, root.editor_active_category, root.editor_filter, root.editor_lang_filter);
                                    }
                                }
                            }
                        }
                    }

                    FormRow {
                        title: "Category:";
                        ComboBox {
                            model: root.available_categories;
                            current-value <=> root.editor_active_category;
                            height: 28px;
                            selected(cat) => {
                                root.editor_active_category = cat;
                                root.load_editor_data(root.editor_cff_dir, cat, root.editor_filter, root.editor_lang_filter);
                            }
                        }
                    }

                    if root.editor_active_category == "Localized Strings": FormRow {
                        title: "Language:";
                        ComboBox {
                            model: root.available_languages;
                            current-value <=> root.editor_lang_filter;
                            height: 28px;
                            selected(lang) => {
                                root.editor_lang_filter = lang;
                                root.load_editor_data(root.editor_cff_dir, root.editor_active_category, root.editor_filter, lang);
                            }
                        }
                    }

                    FormRow {
                        title: "Filter:";
                        LineEdit {
                            text <=> root.editor_filter;
                            placeholder-text: "Filter by ID, mesh or phrase...";
                            height: 28px;
                            font-family: "Consolas";
                            font-size: 11px;
                            edited => {
                                root.load_editor_data(root.editor_cff_dir, root.editor_active_category, root.editor_filter, root.editor_lang_filter);
                            }
                        }
                    }
                }
            }

            PanelSection {
                title: "Parsed Records (" + root.editor_entries.length + " entries)";
                VerticalLayout {
                    spacing: 8px;
                    vertical-stretch: 1;

                    // Action Controls: Add, Duplicate, Delete
                    HorizontalLayout {
                        spacing: 6px;
                        CustomButton {
                            text: "+ Add Entry";
                            primary-color: #23a55a;
                            enabled: root.editor_cff_dir != "";
                            clicked => {
                                root.add_editor_entry(root.editor_cff_dir, root.editor_active_category);
                            }
                        }

                        CustomButton {
                            text: "Duplicate";
                            primary-color: #e59535;
                            enabled: root.editor_selected_idx >= 0 && root.editor_cff_dir != "";
                            clicked => {
                                root.duplicate_editor_entry(
                                    root.editor_cff_dir,
                                    root.editor_active_category,
                                    root.editor_selected_idx,
                                    root.editor_field_id);
                            }
                        }

                        CustomButton {
                            text: "Delete";
                            primary-color: #aa3838;
                            enabled: root.editor_selected_idx >= 0 && root.editor_cff_dir != "";
                            clicked => {
                                root.delete_editor_entry(
                                    root.editor_cff_dir,
                                    root.editor_active_category,
                                    root.editor_selected_idx,
                                    root.editor_field_id);
                            }
                        }
                    }

                    // Unified Language Slot Management Tools
                    if root.editor_active_category == "Localized Strings": HorizontalLayout {
                        spacing: 6px;
                        CustomButton {
                            text: "🌐 Clone Slot...";
                            primary-color: #3e6a90;
                            enabled: root.editor_cff_dir != "";
                            clicked => { clone_popup.show(); }
                        }

                        CustomButton {
                            text: "Export Lang JSON...";
                            primary-color: #4e5058;
                            enabled: root.editor_cff_dir != "";
                            clicked => {
                                let target_f = root.save_file("json");
                                if (target_f != "") {
                                    root.export_single_language(root.editor_cff_dir, root.editor_lang_filter, target_f);
                                }
                            }
                        }

                        CustomButton {
                            text: "Import to Slot...";
                            primary-color: #4e5058;
                            enabled: root.editor_cff_dir != "";
                            clicked => {
                                let src_f = root.browse_file("json");
                                if (src_f != "") {
                                    root.import_language_to_slot(root.editor_cff_dir, root.editor_lang_filter, src_f);
                                }
                            }
                        }
                    }

                    // Adaptive Height Virtual List
                    Rectangle {
                        background: #111214;
                        border-color: #1f2023;
                        border-width: 1px;
                        border-radius: 4px;
                        vertical-stretch: 1;
                        clip: true;

                        ListView {
                            for item[index] in root.editor_entries: Rectangle {
                                height: 26px;
                                background: ta_ed.has-hover ? #393c41 : (root.editor_selected_idx == index ? #2c3e50 : (Math.mod(index, 2) == 0 ? #191919 : #1c1c1c));
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: item.text;
                                        color: root.editor_selected_idx == index ? #f0b132 : #dcddde;
                                        font-family: "Consolas";
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                ta_ed := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.editor_selected_idx = index;
                                        root.select_editor_entry(index);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // RESIZE SPLITTER
    Rectangle {
        width: 8px;
        background: splitter-ta.has-hover ? #474747 : #181818;

        Rectangle {
            width: 2px;
            height: 24px;
            background: #808080;
            border-radius: 1px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        splitter-ta := TouchArea {
            mouse-cursor: col-resize;
            moved => {
                if self.pressed {
                    root.sidebar_width = (root.sidebar_width + self.mouse-x - self.pressed-x).clamp(340px, 680px);
                }
            }
        }
    }

    // RIGHT PANEL: VISUAL SHOWCASE & INSPECTOR
    Rectangle {
        horizontal-stretch: 1;
        background: #2b2d31;
        border-color: #1f2023;
        border-width: 1px;
        border-radius: 4px;
        clip: true;

        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            alignment: start;

            // Inspector Header with Undo / Redo / Discard Controls
            HorizontalLayout {
                alignment: space-between;

                SectionTitle {
                    text: "Entity Property & Visual Showcase";
                    text-color: #f0b132;
                    width: 250px;
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: end;

                    CustomButton {
                        text: "↶ Undo";
                        compact: true;
                        width: 65px;
                        height: 24px;
                        primary-color: #4e5058;
                        enabled: root.can_undo;
                        clicked => { root.editor_undo(); }
                    }

                    CustomButton {
                        text: "↷ Redo";
                        compact: true;
                        width: 65px;
                        height: 24px;
                        primary-color: #4e5058;
                        enabled: root.can_redo;
                        clicked => { root.editor_redo(); }
                    }

                    CustomButton {
                        text: "↺ Discard";
                        compact: true;
                        width: 70px;
                        height: 24px;
                        primary-color: #353535;
                        enabled: root.editor_selected_idx >= 0;
                        clicked => {
                            root.select_editor_entry(root.editor_selected_idx);
                        }
                    }
                }
            }

            // A. DUAL CARDS FOR SPELLS MAPPING (0x07E2)
            if root.editor_active_category == "Spells Mapping (0x07E2)": HorizontalLayout {
                spacing: 12px;
                alignment: center;
                height: 125px;

                // Left Card: Combat Spell
                Rectangle {
                    width: 180px;
                    background: #18191b;
                    border-color: #353535;
                    border-width: 1px;
                    border-radius: 6px;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;
                        alignment: center;

                        Rectangle {
                            width: 64px;
                            height: 64px;
                            background: #111214;
                            border-color: #e59535;
                            border-width: 1px;
                            border-radius: 4px;
                            clip: true;

                            Image {
                                source: root.preview_icon1;
                                width: 100%;
                                height: 100%;
                                image-fit: contain;
                            }
                        }

                        Text {
                            text: root.spell_name_disp != "" ? root.spell_name_disp : "Combat Spell";
                            font-size: 11px;
                            font-weight: 700;
                            color: #f0b132;
                            horizontal-alignment: center;
                            overflow: elide;
                        }

                        Text {
                            text: "Spell ID: " + root.editor_field_id;
                            font-size: 10px;
                            color: #808080;
                            horizontal-alignment: center;
                        }
                    }
                }

                // Center Arrow Linkage
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "➔";
                        font-size: 22px;
                        font-weight: 700;
                        color: #f0b132;
                        vertical-alignment: center;
                    }
                }

                // Right Card: Inventory Scroll
                Rectangle {
                    width: 180px;
                    background: #18191b;
                    border-color: #353535;
                    border-width: 1px;
                    border-radius: 6px;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;
                        alignment: center;

                        Rectangle {
                            width: 64px;
                            height: 64px;
                            background: #111214;
                            border-color: #3e6a90;
                            border-width: 1px;
                            border-radius: 4px;
                            clip: true;

                            Image {
                                source: root.preview_icon2;
                                width: 100%;
                                height: 100%;
                                image-fit: contain;
                            }
                        }

                        Text {
                            text: root.scroll_name_disp != "" ? root.scroll_name_disp : "Inventory Scroll";
                            font-size: 11px;
                            font-weight: 700;
                            color: #3e6a90;
                            horizontal-alignment: center;
                            overflow: elide;
                        }

                        Text {
                            text: "Scroll ID: " + root.editor_field_val1;
                            font-size: 10px;
                            color: #808080;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            // B. SINGLE LIVE PREVIEW SHOWCASE FOR 2D / 3D GFX ITEMS & ABILITIES
            if root.editor_active_category != "Spells Mapping (0x07E2)" && root.editor_active_category != "Localized Strings": HorizontalLayout {
                spacing: 12px;
                alignment: start;
                height: 96px;

                Rectangle {
                    width: 96px;
                    height: 96px;
                    background: #111214;
                    border-color: #f0b132;
                    border-width: 1.5px;
                    border-radius: 6px;
                    clip: true;

                    Image {
                        source: root.preview_icon1;
                        width: 100%;
                        height: 100%;
                        image-fit: contain;
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    alignment: center;

                    Text {
                        text: "Texture Asset Status:";
                        font-size: 11px;
                        font-weight: 700;
                        color: #949ba4;
                    }

                    Text {
                        text: root.asset_status_text;
                        font-size: 11px;
                        font-family: "Consolas";
                        color: #dcddde;
                        wrap: word-wrap;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: #353535;
            }

            // FIELDS FORM
            FormRow {
                title: "Record Key / ID:";
                label-width: 140px;
                LineEdit {
                    text <=> root.editor_field_id;
                    read-only: true;
                    font-family: "Consolas";
                    height: 28px;
                }
            }

            if root.editor_active_category == "Localized Strings": VerticalLayout {
                spacing: 4px;
                Text {
                    text: "Localized Text Content:";
                    font-size: 11px;
                    color: #dcddde;
                }

                TextEdit {
                    text <=> root.editor_field_val1;
                    font-family: "Consolas";
                    font-size: 12px;
                    height: 140px;
                    wrap: TextWrap.word-wrap;
                }
            }

            if root.editor_active_category != "Localized Strings": FormRow {
                title: (root.editor_active_category == "2D Gfx Items (0x07DC)" || root.editor_active_category == "Visual Meshes (0x2335)" || root.editor_active_category == "Abilities (0x234E)") ? "Mesh / Icon Asset:" :
                    (root.editor_active_category == "Weapon Stats (0x07DF)") ? "Damage (Min-Max):" :
                    (root.editor_active_category == "Units Master (0x07E8)") ? "XP Gain:" :
                    (root.editor_active_category == "Unit Loot Tables (0x07F8)") ? "Loot Items (1, 2, 3):" : "Target / Scroll ID:";
                label-width: 140px;
                LineEdit {
                    text <=> root.editor_field_val1;
                    font-family: "Consolas";
                    height: 28px;
                }
            }

            FormRow {
                title: "Extra / Parameters:";
                label-width: 140px;
                LineEdit {
                    text <=> root.editor_field_val2;
                    font-family: "Consolas";
                    height: 28px;
                }
            }

            CustomButton {
                text: "Save Changes to Database Chunk (.dat)";
                enabled: root.editor_selected_idx >= 0 && root.editor_cff_dir != "";
                primary-color: #23a55a;
                height: 32px;
                clicked => {
                    root.save_editor_entry(
                        root.editor_cff_dir,
                        root.editor_active_category,
                        root.editor_selected_idx,
                        root.editor_field_id,
                        root.editor_field_val1,
                        root.editor_field_val2);
                }
            }

            Rectangle {
                height: 1px;
                background: #353535;
            }

            Text {
                text: "Live Visual Preview & Multi-Language Guide:\n" +
                    "• Asset Source: Select a .pak file or folder to stream DDS/TGA textures directly on the fly.\n" +
                    "• Phenomic VFS Layering: Automatically mounts archives in reverse order (sf35.pak -> sf0.pak).\n" +
                    "• Spells Mapping: Side-by-side Dual Cards cross-referencing Combat Spell and Inventory Scroll.\n" +
                    "• Math Architecture: str_id = (campaign << 24) | (lang_id << 16) | base_id.\n" +
                    "• ↶ Undo / ↷ Redo: Revert changes made during current session.";
                color: #808080;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
}
