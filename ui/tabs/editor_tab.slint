// ui/tabs/editor_tab.slint

import {
    LineEdit,
    ComboBox,
    ListView,
    ScrollView,
    StandardListView,
    TextEdit,
    SpinBox,
} from "std-widgets.slint";
import { CustomButton } from "../components/buttons.slint";
import {
    SectionTitle,
    PanelSection,
    FormRow,
} from "../components/common.slint";

export struct GraphNodeData {
    id: int,
    title: string,
    subtitle: string,
    is_main: bool,
    x: length,
    y: length,
    width: length,
    height: length,
    record_index: int,
}

export struct GraphEdgeData {
    from_x: length,
    from_y: length,
    to_x: length,
    to_y: length,
}

component InspectorCell {
    in property <string> label: "";
    in-out property <string> value: "";
    in property <bool> read-only: false;

    VerticalLayout {
        spacing: 3px;
        Text {
            text: root.label;
            font-size: 11px;
            font-weight: 600;
            color: #949ba4;
            overflow: elide;
        }

        LineEdit {
            text <=> root.value;
            read-only: root.read-only;
            font-family: "Consolas";
            font-size: 11px;
            height: 28px;
        }
    }
}

export component EditorTab inherits HorizontalLayout {
    // 4-Column Responsive Dimensions
    in-out property <length> col1_width: 210px;
    in-out property <length> col2_width: 270px;
    in-out property <length> col4_width: 360px;

    // Database & Category State
    in-out property <string> editor_cff_dir: "";
    in-out property <string> editor_asset_source: "";
    in-out property <string> editor_filter: "";
    in-out property <string> editor_active_category: "2D Gfx Items (0x07DC)";
    in-out property <[string]> available_categories: [
        "2D Gfx Items (0x07DC)",
        "Spell Lines (0x0806)",
        "Spells Master (0x07D2)",
        "Tech Tree Upgrades (0x07F4)",
        "Items Master (0x07D3)",
        "Item Modifiers (0x07D4)",
        "Unit Stats (0x07D5)",
        "Weapon Stats (0x07DF)",
        "Spells Mapping (0x07E2)",
        "Races (0x07E6)",
        "Units Master (0x07E8)",
        "Buildings Master (0x07ED)",
        "Building Collision (0x07EE)",
        "Unit Loot Tables (0x07F8)",
        "Chest Loot Tables (0x0811)",
        "Level Progression (0x0800)",
        "Objects Master (0x0802)",
        "Object Collision (0x0809)",
        "Unit Equipment (0x07E9)",
        "Merchant Inventory (0x07FA)",
        "Quests (0x080D)",
        "Weapon Types (0x080F)",
        "Weapon Materials (0x0810)",
        "Item Sets (0x0818)",
        "Terrain Cultivation (0x07F0)",
        "Portals (0x0805)",
        "Descriptions (0x080A)",
        "Localized Strings"
    ];
    in-out property <string> editor_lang_filter: "All Languages";
    in-out property <[string]> available_languages: [
        "All Languages",
        "Slot 0: German [DE]",
        "Slot 1: English [EN]",
        "Slot 2: French [FR]",
        "Slot 3: Spanish [ES]",
        "Slot 4: Italian [IT]"
    ];

    // Reactive category state flags
    property <bool> is_quest: root.editor_active_category == "Quests (0x080D)";
    property <bool> is_spells_map: root.editor_active_category == "Spells Mapping (0x07E2)";
    property <bool> is_loca: root.editor_active_category == "Localized Strings";
    property <bool> is_loot: root.editor_active_category == "Unit Loot Tables (0x07F8)" || root.editor_active_category == "Chest Loot Tables (0x0811)";
    property <bool> is_collision: root.editor_active_category == "Building Collision (0x07EE)" || root.editor_active_category == "Object Collision (0x0809)";
    property <bool> is_weapon_stats: root.editor_active_category == "Weapon Stats (0x07DF)";

    // Record Explorer State
    in-out property <[StandardListViewItem]> editor_entries: [];
    in-out property <int> editor_selected_idx: -1;
    in-out property <string> editor_field_id: "";
    in-out property <string> editor_field_val1: "";
    in-out property <string> editor_field_val2: "";

    // 12-Field Inspector Properties
    in-out property <string> editor_field_p1: "";
    in-out property <string> editor_field_p2: "";
    in-out property <string> editor_field_p3: "";
    in-out property <string> editor_field_p4: "";
    in-out property <string> editor_field_p5: "";
    in-out property <string> editor_field_p6: "";
    in-out property <string> editor_field_p7: "";
    in-out property <string> editor_field_p8: "";
    in-out property <string> editor_field_p9: "";
    in-out property <string> editor_field_p10: "";
    in-out property <string> editor_field_p11: "";
    in-out property <string> editor_field_p12: "";

    in-out property <string> editor_label_p1: "";
    in-out property <string> editor_label_p2: "";
    in-out property <string> editor_label_p3: "";
    in-out property <string> editor_label_p4: "";
    in-out property <string> editor_label_p5: "";
    in-out property <string> editor_label_p6: "";
    in-out property <string> editor_label_p7: "";
    in-out property <string> editor_label_p8: "";
    in-out property <string> editor_label_p9: "";
    in-out property <string> editor_label_p10: "";
    in-out property <string> editor_label_p11: "";
    in-out property <string> editor_label_p12: "";

    // Pagination State
    in-out property <int> current_page: 1;
    in-out property <int> total_pages: 1;
    in-out property <string> page_info: "Page 1 of 1 (0 records)";

    // Visual Canvas & Node Graph State
    in-out property <[GraphNodeData]> graph_nodes: [];
    in-out property <[GraphEdgeData]> graph_edges: [];
    in-out property <length> canvas_pan_x: 40px;
    in-out property <length> canvas_pan_y: 40px;
    in-out property <int> selected_node_id: -1;

    // Visual Assets & Dual Card State
    in-out property <image> preview_icon1;
    in-out property <image> preview_icon2;
    in-out property <string> spell_name_disp: "";
    in-out property <string> scroll_name_disp: "";
    in-out property <string> asset_status_text: "Select a record to preview asset.";

    // Undo / Redo History Flags
    in-out property <bool> can_undo: false;
    in-out property <bool> can_redo: false;

    // Language Clone Wizard State
    in-out property <int> clone_src_slot: 1;
    in-out property <int> clone_dst_slot: 6;
    in-out property <string> clone_lang_tag: "AR";

    callback browse_folder() -> string;
    callback browse_file(string) -> string;
    callback save_file(string) -> string;

    callback load_editor_data(string, string, string, string);
    callback change_page(string, string, string, string, int);
    callback select_editor_entry(int);
    callback save_editor_entry(string, string, int, [string]);
    callback add_editor_entry(string, string);
    callback duplicate_editor_entry(string, string, int, string);
    callback delete_editor_entry(string, string, int, string);

    callback load_quest_graph(string);
    callback editor_undo();
    callback editor_redo();

    callback export_single_language(string, string, string);
    callback import_language_to_slot(string, string, string);
    callback execute_clone_language(string, int, int, string, string);

    spacing: 0px;

    // MODAL POPUP: Language Clone Wizard
    clone_popup := PopupWindow {
        width: 380px;
        height: 250px;
        close-policy: close-on-click-outside;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        Rectangle {
            background: #232529;
            border-color: #f0b132;
            border-width: 1.5px;
            border-radius: 6px;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                Text {
                    text: "Clone Language Slot (One-Click Wizard)";
                    font-size: 13px;
                    font-weight: 700;
                    color: #ffffff;
                }

                Rectangle {
                    height: 1px;
                    background: #353535;
                }

                FormRow {
                    title: "Source Slot:";
                    label-width: 100px;
                    SpinBox {
                        value <=> root.clone_src_slot;
                        minimum: 0;
                        maximum: 4;
                        height: 28px;
                    }
                }

                FormRow {
                    title: "New Slot ID:";
                    label-width: 100px;
                    SpinBox {
                        value <=> root.clone_dst_slot;
                        minimum: 5;
                        maximum: 255;
                        height: 28px;
                    }
                }

                FormRow {
                    title: "Language Tag:";
                    label-width: 100px;
                    LineEdit {
                        text <=> root.clone_lang_tag;
                        placeholder-text: "e.g. AR, TH, RU, PL, ZH";
                        font-family: "Consolas";
                        height: 28px;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    CustomButton {
                        text: "Cancel";
                        primary-color: #4e5058;
                        clicked => { clone_popup.close(); }
                    }

                    CustomButton {
                        text: "Clone & Export JSON";
                        primary-color: #23a55a;
                        clicked => {
                            let out_json = root.save_file("json");
                            if (out_json != "") {
                                root.execute_clone_language(
                                    root.editor_cff_dir,
                                    root.clone_src_slot,
                                    root.clone_dst_slot,
                                    root.clone_lang_tag,
                                    out_json);
                                clone_popup.close();
                            }
                        }
                    }
                }
            }
        }
    }

    // =========================================================================
    // COLUMN 1: DOMAINS & CATEGORIES (~210px)
    // =========================================================================
    Rectangle {
        width: root.col1_width;
        background: #1e1f22;

        Rectangle {
            x: parent.width - 1px;
            width: 1px;
            background: #111214;
        }

        VerticalLayout {
            padding: 8px;
            spacing: 8px;

            Text {
                text: "DATA DOMAINS";
                font-size: 11px;
                font-weight: 700;
                color: #80848e;
            }

            HorizontalLayout {
                spacing: 4px;
                LineEdit {
                    text <=> root.editor_cff_dir;
                    placeholder-text: "CFF folder...";
                    font-family: "Consolas";
                    font-size: 10px;
                    height: 26px;
                }

                CustomButton {
                    text: "...";
                    compact: true;
                    width: 26px;
                    height: 26px;
                    clicked => {
                        let f = root.browse_folder();
                        if (f != "") {
                            root.editor_cff_dir = f;
                            root.load_editor_data(root.editor_cff_dir, root.editor_active_category, root.editor_filter, root.editor_lang_filter);
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: #2b2d31;
            }

            ListView {
                for cat in root.available_categories: Rectangle {
                    height: 26px;
                    border-radius: 4px;
                    background: cat == root.editor_active_category ? #3e6a90 : (ta_cat.has-hover ? #2b2d31 : #1e1f22);

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;

                        Text {
                            text: cat;
                            font-size: 11px;
                            font-weight: cat == root.editor_active_category ? 700 : 500;
                            color: cat == root.editor_active_category ? #ffffff : (ta_cat.has-hover ? #dcddde : #949ba4);
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    ta_cat := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.editor_active_category = cat;
                            root.load_editor_data(root.editor_cff_dir, cat, root.editor_filter, root.editor_lang_filter);
                            if (cat == "Quests (0x080D)") {
                                root.load_quest_graph(root.editor_cff_dir);
                            }
                        }
                    }
                }
            }
        }
    }

    // SPLITTER 1
    Rectangle {
        width: 6px;
        background: s1_ta.has-hover ? #474747 : #181818;
        Rectangle {
            width: 2px;
            height: 24px;
            background: #808080;
            border-radius: 1px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        s1_ta := TouchArea {
            mouse-cursor: col-resize;
            moved => {
                if self.pressed {
                    root.col1_width = (root.col1_width + self.mouse-x - self.pressed-x).clamp(180px, 320px);
                }
            }
        }
    }

    // =========================================================================
    // COLUMN 2: RECORD EXPLORER & PAGINATION (~270px)
    // =========================================================================
    Rectangle {
        width: root.col2_width;
        background: #2b2d31;

        VerticalLayout {
            padding: 8px;
            spacing: 6px;

            // Search Bar
            LineEdit {
                text <=> root.editor_filter;
                placeholder-text: "🔍 Filter entries...";
                font-family: "Consolas";
                font-size: 11px;
                height: 28px;
                edited => {
                    root.load_editor_data(root.editor_cff_dir, root.editor_active_category, root.editor_filter, root.editor_lang_filter);
                }
            }

            // RESTORED: Language Selector & Clone Wizard for Localized Strings
            if root.is_loca: HorizontalLayout {
                spacing: 4px;
                height: 26px;

                ComboBox {
                    model: root.available_languages;
                    current-value <=> root.editor_lang_filter;
                    height: 26px;
                    horizontal-stretch: 1;
                    selected => {
                        root.change_page(
                            root.editor_cff_dir,
                            root.editor_active_category,
                            root.editor_filter,
                            root.editor_lang_filter,
                            1);
                    }
                }

                CustomButton {
                    text: "Clone...";
                    compact: true;
                    width: 58px;
                    height: 26px;
                    primary-color: #f0b132;
                    clicked => { clone_popup.show(); }
                }
            }

            // Action Buttons
            HorizontalLayout {
                spacing: 4px;
                height: 26px;

                CustomButton {
                    text: "+ Add";
                    primary-color: #23a55a;
                    enabled: root.editor_cff_dir != "";
                    clicked => {
                        root.add_editor_entry(root.editor_cff_dir, root.editor_active_category);
                    }
                }

                CustomButton {
                    text: "Duplicate";
                    primary-color: #e59535;
                    enabled: root.editor_selected_idx >= 0 && root.editor_cff_dir != "";
                    clicked => {
                        root.duplicate_editor_entry(
                            root.editor_cff_dir,
                            root.editor_active_category,
                            root.editor_selected_idx,
                            root.editor_field_id);
                    }
                }

                CustomButton {
                    text: "Delete";
                    primary-color: #aa3838;
                    enabled: root.editor_selected_idx >= 0 && root.editor_cff_dir != "";
                    clicked => {
                        root.delete_editor_entry(
                            root.editor_cff_dir,
                            root.editor_active_category,
                            root.editor_selected_idx,
                            root.editor_field_id);
                    }
                }
            }

            // Pagination Bar
            HorizontalLayout {
                spacing: 4px;
                height: 24px;
                alignment: center;

                CustomButton {
                    text: "◀";
                    compact: true;
                    width: 28px;
                    enabled: root.current_page > 1;
                    clicked => {
                        root.change_page(
                            root.editor_cff_dir,
                            root.editor_active_category,
                            root.editor_filter,
                            root.editor_lang_filter,
                            root.current_page - 1);
                    }
                }

                Text {
                    text: root.page_info;
                    font-family: "Consolas";
                    font-size: 10px;
                    color: #cfcfcf;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                CustomButton {
                    text: "▶";
                    compact: true;
                    width: 28px;
                    enabled: root.current_page < root.total_pages;
                    clicked => {
                        root.change_page(
                            root.editor_cff_dir,
                            root.editor_active_category,
                            root.editor_filter,
                            root.editor_lang_filter,
                            root.current_page + 1);
                    }
                }
            }

            // Record List
            Rectangle {
                background: #111214;
                border-color: #1f2023;
                border-width: 1px;
                border-radius: 4px;
                vertical-stretch: 1;
                clip: true;

                ListView {
                    for item[index] in root.editor_entries: Rectangle {
                        height: 26px;
                        background: ta_ed.has-hover ? #393c41 : (root.editor_selected_idx == index ? #2c3e50 : (Math.mod(index, 2) == 0 ? #191919 : #1c1c1c));

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: item.text;
                                color: root.editor_selected_idx == index ? #f0b132 : #dcddde;
                                font-family: "Consolas";
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        ta_ed := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.editor_selected_idx = index;
                                root.select_editor_entry(index);
                            }
                        }
                    }
                }
            }
        }
    }

    // SPLITTER 2
    Rectangle {
        width: 6px;
        background: s2_ta.has-hover ? #474747 : #181818;
        Rectangle {
            width: 2px;
            height: 24px;
            background: #808080;
            border-radius: 1px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        s2_ta := TouchArea {
            mouse-cursor: col-resize;
            moved => {
                if self.pressed {
                    root.col2_width = (root.col2_width + self.mouse-x - self.pressed-x).clamp(220px, 400px);
                }
            }
        }
    }

    // =========================================================================
    // COLUMN 3: INTERACTIVE VISUAL CANVAS / FULL TEXT EDITOR (Flex Width)
    // =========================================================================
    Rectangle {
        horizontal-stretch: 1;
        background: #141517;
        clip: true;

        VerticalLayout {
            // Toolbar
            Rectangle {
                height: 34px;
                background: #1e1f22;

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: #2b2d31;
                }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    alignment: space-between;

                    Text {
                        text: root.is_quest ? "🕸️ Quest Dependency Graph (Interactive Flow)" : (root.is_loca ? "📖 Fullscreen Localization Editor & Formatting Workspace" : "📐 Visual Blueprint & Canvas Preview");
                        font-size: 11px;
                        font-weight: 700;
                        color: #f0b132;
                        vertical-alignment: center;
                    }

                    if root.is_quest: HorizontalLayout {
                        spacing: 6px;
                        alignment: end;

                        CustomButton {
                            text: "⟲ Center Graph";
                            compact: true;
                            width: 110px;
                            height: 24px;
                            primary-color: #3e6a90;
                            clicked => {
                                root.canvas_pan_x = 40px;
                                root.canvas_pan_y = 40px;
                            }
                        }
                    }
                }
            }

            // Canvas Workspace
            Rectangle {
                vertical-stretch: 1;
                clip: true;

                // 1. QUESTS MODE: Infinite Node Canvas with Real Titles
                if root.is_quest: Rectangle {
                    Rectangle {
                        x: root.canvas_pan_x;
                        y: root.canvas_pan_y;

                        for edge in root.graph_edges: Rectangle {
                            Rectangle {
                                x: edge.from-x;
                                y: edge.from-y - 1px;
                                width: (edge.to-x - edge.from-x) / 2;
                                height: 2px;
                                background: #4e5058;
                            }

                            Rectangle {
                                x: edge.from-x + (edge.to-x - edge.from-x) / 2;
                                y: Math.min(edge.from-y, edge.to-y) - 1px;
                                width: 2px;
                                height: Math.abs(edge.to-y - edge.from-y) + 2px;
                                background: #4e5058;
                            }

                            Rectangle {
                                x: edge.from-x + (edge.to-x - edge.from-x) / 2;
                                y: edge.to-y - 1px;
                                width: (edge.to-x - edge.from-x) / 2;
                                height: 2px;
                                background: #4e5058;
                            }
                        }

                        for node in root.graph_nodes: Rectangle {
                            x: node.x;
                            y: node.y;
                            width: node.width;
                            height: node.height;
                            background: #1e1f22;
                            border-radius: 6px;
                            border-width: root.selected_node_id == node.id ? 2px : 1px;
                            border-color: root.selected_node_id == node.id ? #f0b132 : (node.is_main ? #e59535 : #3e6a90);

                            VerticalLayout {
                                Rectangle {
                                    height: 22px;
                                    background: node.is_main ? #995511 : #224466;
                                    border-top-left-radius: 5px;
                                    border-top-right-radius: 5px;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text {
                                            text: node.title;
                                            font-size: 10px;
                                            font-weight: 700;
                                            color: #ffffff;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }

                                VerticalLayout {
                                    padding: 6px;
                                    alignment: center;
                                    Text {
                                        text: node.subtitle;
                                        font-size: 9px;
                                        font-family: "Consolas";
                                        color: #cfcfcf;
                                        overflow: elide;
                                    }
                                }
                            }

                            Rectangle {
                                x: -4px;
                                y: (parent.height - self.height) / 2;
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: #3e6a90;
                            }

                            Rectangle {
                                x: parent.width - 4px;
                                y: (parent.height - self.height) / 2;
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: #f0b132;
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.selected_node_id = node.id;
                                    root.editor_selected_idx = node.record_index;
                                    root.select_editor_entry(node.record_index);
                                }
                            }
                        }
                    }

                    TouchArea {
                        moved => {
                            if self.pressed {
                                root.canvas_pan_x += self.mouse-x - self.pressed-x;
                                root.canvas_pan_y += self.mouse-y - self.pressed-y;
                            }
                        }
                    }
                }

                // 2. FULLSCREEN TEXT EDITOR FOR LOCALIZED STRINGS (Instead of empty canvas!)
                if root.is_loca: VerticalLayout {
                    padding: 16px;
                    spacing: 8px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Phrase Content (" + root.editor_field_val2 + "):";
                            font-size: 12px;
                            font-weight: 700;
                            color: #f0b132;
                        }
                    }

                    TextEdit {
                        text <=> root.editor_field_val1;
                        font-family: "Consolas";
                        font-size: 13px;
                        wrap: TextWrap.word-wrap;
                        vertical-stretch: 1;
                    }

                    Text {
                        text: "Tip: Edit in this wide canvas and click 'Save Record Changes' on the right panel to update the .dat chunk.";
                        font-size: 11px;
                        color: #80848e;
                    }
                }

                // 3. GENERAL PREVIEWS (Collision polygons, Spells Dual-Cards, Textures)
                if !root.is_quest && !root.is_loca: VerticalLayout {
                    alignment: center;
                    spacing: 12px;
                    padding: 16px;

                    if root.is_spells_map: HorizontalLayout {
                        spacing: 20px;
                        alignment: center;

                        Rectangle {
                            width: 170px;
                            height: 160px;
                            background: #18191b;
                            border-color: #353535;
                            border-width: 1px;
                            border-radius: 6px;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;
                                alignment: center;
                                Rectangle {
                                    width: 72px;
                                    height: 72px;
                                    background: #111214;
                                    border-color: #f0b132;
                                    border-width: 1px;
                                    border-radius: 4px;
                                    clip: true;
                                    Image {
                                        source: root.preview_icon1;
                                        width: 100%;
                                        height: 100%;
                                        image-fit: contain;
                                    }
                                }

                                Text {
                                    text: root.spell_name_disp != "" ? root.spell_name_disp : "Combat Spell";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #f0b132;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: "Spell ID: " + root.editor_field_id;
                                    font-size: 10px;
                                    color: #808080;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        Text {
                            text: "➔";
                            font-size: 26px;
                            font-weight: 700;
                            color: #f0b132;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 170px;
                            height: 160px;
                            background: #18191b;
                            border-color: #353535;
                            border-width: 1px;
                            border-radius: 6px;
                            VerticalLayout {
                                padding: 10px;
                                spacing: 6px;
                                alignment: center;
                                Rectangle {
                                    width: 72px;
                                    height: 72px;
                                    background: #111214;
                                    border-color: #3e6a90;
                                    border-width: 1px;
                                    border-radius: 4px;
                                    clip: true;
                                    Image {
                                        source: root.preview_icon2;
                                        width: 100%;
                                        height: 100%;
                                        image-fit: contain;
                                    }
                                }

                                Text {
                                    text: root.scroll_name_disp != "" ? root.scroll_name_disp : "Scroll Item";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #3e6a90;
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: "Scroll ID: " + root.editor_field_val1;
                                    font-size: 10px;
                                    color: #808080;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }

                    if !root.is_spells_map: VerticalLayout {
                        alignment: center;
                        spacing: 8px;

                        Rectangle {
                            width: 200px;
                            height: 200px;
                            background: #111214;
                            border-color: #f0b132;
                            border-width: 1.5px;
                            border-radius: 6px;
                            clip: true;
                            x: (parent.width - self.width) / 2;

                            Image {
                                source: root.preview_icon1;
                                width: 100%;
                                height: 100%;
                                image-fit: contain;
                            }
                        }

                        Text {
                            text: root.asset_status_text;
                            font-size: 11px;
                            font-family: "Consolas";
                            color: #dcddde;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }
    }

    // SPLITTER 3
    Rectangle {
        width: 6px;
        background: s3_ta.has-hover ? #474747 : #181818;
        Rectangle {
            width: 2px;
            height: 24px;
            background: #808080;
            border-radius: 1px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        s3_ta := TouchArea {
            mouse-cursor: col-resize;
            moved => {
                if self.pressed {
                    root.col4_width = (root.col4_width - self.mouse-x + self.pressed-x).clamp(320px, 500px);
                }
            }
        }
    }

    // =========================================================================
    // COLUMN 4: DETAILS INSPECTOR (Fixed Grid & Compact Alignment)
    // =========================================================================
    Rectangle {
        width: root.col4_width;
        background: #2b2d31;

        ScrollView {
            VerticalLayout {
                alignment: start; // PREVENTS VERTICAL STRETCHING
                padding: 12px;
                spacing: 8px;

                // Inspector Header
                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: "DETAILS INSPECTOR";
                        font-size: 11px;
                        font-weight: 700;
                        color: #f0b132;
                        vertical-alignment: center;
                    }

                    HorizontalLayout {
                        spacing: 4px;

                        CustomButton {
                            text: "↶ Undo";
                            compact: true;
                            width: 55px;
                            height: 24px;
                            primary-color: #4e5058;
                            enabled: root.can_undo;
                            clicked => { root.editor_undo(); }
                        }

                        CustomButton {
                            text: "↷ Redo";
                            compact: true;
                            width: 55px;
                            height: 24px;
                            primary-color: #4e5058;
                            enabled: root.can_redo;
                            clicked => { root.editor_redo(); }
                        }

                        CustomButton {
                            text: "↺";
                            compact: true;
                            width: 26px;
                            height: 24px;
                            primary-color: #353535;
                            enabled: root.editor_selected_idx >= 0;
                            clicked => { root.select_editor_entry(root.editor_selected_idx); }
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: #353535;
                }

                // Record Key / ID
                FormRow {
                    title: "Record Key / ID:";
                    label-width: 110px;
                    LineEdit {
                        text <=> root.editor_field_id;
                        read-only: true;
                        font-family: "Consolas";
                        height: 28px;
                    }
                }

                // VIEW A: Compact Metadata for Localized Strings
                if root.is_loca: VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "Metadata: " + root.editor_field_val2;
                        font-family: "Consolas";
                        font-size: 11px;
                        color: #cfcfcf;
                    }
                }

                // VIEW B: Paired Rows for Clean Alignment (P1..P12)
                if !root.is_loca: VerticalLayout {
                    spacing: 8px;

                    // Row 1: P1 & P2
                    if root.editor_label_p1 != "" || root.editor_label_p2 != "": HorizontalLayout {
                        spacing: 8px;
                        if root.editor_label_p1 != "": InspectorCell {
                            label: root.editor_label_p1;
                            value <=> root.editor_field_p1;
                        }
                        if root.editor_label_p1 == "": Rectangle {
                            horizontal-stretch: 1;
                        }

                        if root.editor_label_p2 != "": InspectorCell {
                            label: root.editor_label_p2;
                            value <=> root.editor_field_p2;
                        }
                        if root.editor_label_p2 == "": Rectangle {
                            horizontal-stretch: 1;
                        }
                    }

                    // Row 2: P3 & P4
                    if root.editor_label_p3 != "" || root.editor_label_p4 != "": HorizontalLayout {
                        spacing: 8px;
                        if root.editor_label_p3 != "": InspectorCell {
                            label: root.editor_label_p3;
                            value <=> root.editor_field_p3;
                        }
                        if root.editor_label_p3 == "": Rectangle {
                            horizontal-stretch: 1;
                        }

                        if root.editor_label_p4 != "": InspectorCell {
                            label: root.editor_label_p4;
                            value <=> root.editor_field_p4;
                            read-only: root.is_weapon_stats;
                        }
                        if root.editor_label_p4 == "": Rectangle {
                            horizontal-stretch: 1;
                        }
                    }

                    // Row 3: P5 & P6
                    if root.editor_label_p5 != "" || root.editor_label_p6 != "": HorizontalLayout {
                        spacing: 8px;
                        if root.editor_label_p5 != "": InspectorCell {
                            label: root.editor_label_p5;
                            value <=> root.editor_field_p5;
                        }
                        if root.editor_label_p5 == "": Rectangle {
                            horizontal-stretch: 1;
                        }

                        if root.editor_label_p6 != "": InspectorCell {
                            label: root.editor_label_p6;
                            value <=> root.editor_field_p6;
                        }
                        if root.editor_label_p6 == "": Rectangle {
                            horizontal-stretch: 1;
                        }
                    }

                    // Row 4: P7 & P8
                    if root.editor_label_p7 != "" || root.editor_label_p8 != "": HorizontalLayout {
                        spacing: 8px;
                        if root.editor_label_p7 != "": InspectorCell {
                            label: root.editor_label_p7;
                            value <=> root.editor_field_p7;
                            read-only: root.is_loot;
                        }
                        if root.editor_label_p7 == "": Rectangle {
                            horizontal-stretch: 1;
                        }

                        if root.editor_label_p8 != "": InspectorCell {
                            label: root.editor_label_p8;
                            value <=> root.editor_field_p8;
                            read-only: root.is_loot;
                        }
                        if root.editor_label_p8 == "": Rectangle {
                            horizontal-stretch: 1;
                        }
                    }

                    // Row 5: P9 & P10
                    if root.editor_label_p9 != "" || root.editor_label_p10 != "": HorizontalLayout {
                        spacing: 8px;
                        if root.editor_label_p9 != "": InspectorCell {
                            label: root.editor_label_p9;
                            value <=> root.editor_field_p9;
                            read-only: root.is_loot;
                        }
                        if root.editor_label_p9 == "": Rectangle {
                            horizontal-stretch: 1;
                        }

                        if root.editor_label_p10 != "": InspectorCell {
                            label: root.editor_label_p10;
                            value <=> root.editor_field_p10;
                        }
                        if root.editor_label_p10 == "": Rectangle {
                            horizontal-stretch: 1;
                        }
                    }

                    // Row 6: P11 & P12
                    if root.editor_label_p11 != "" || root.editor_label_p12 != "": HorizontalLayout {
                        spacing: 8px;
                        if root.editor_label_p11 != "": InspectorCell {
                            label: root.editor_label_p11;
                            value <=> root.editor_field_p11;
                        }
                        if root.editor_label_p11 == "": Rectangle {
                            horizontal-stretch: 1;
                        }

                        if root.editor_label_p12 != "": InspectorCell {
                            label: root.editor_label_p12;
                            value <=> root.editor_field_p12;
                        }
                        if root.editor_label_p12 == "": Rectangle {
                            horizontal-stretch: 1;
                        }
                    }
                }

                // Save Action Button
                CustomButton {
                    text: "Save Record Changes (.dat)";
                    enabled: root.editor_selected_idx >= 0 && root.editor_cff_dir != "" && !root.is_collision;
                    primary-color: #23a55a;
                    height: 32px;
                    clicked => {
                        root.save_editor_entry(
                            root.editor_cff_dir,
                            root.editor_active_category,
                            root.editor_selected_idx,
                            [
                            root.editor_field_id,
                            root.editor_field_p1,
                            root.editor_field_p2,
                            root.editor_field_p3,
                            root.editor_field_p4,
                            root.editor_field_p5,
                            root.editor_field_p6,
                            root.editor_field_p7,
                            root.editor_field_p8,
                            root.editor_field_p9,
                            root.editor_field_p10,
                            root.editor_field_p11,
                            root.editor_field_p12,
                            root.editor_field_val1
                        ]);
                    }
                }
            }
        }
    }
}
