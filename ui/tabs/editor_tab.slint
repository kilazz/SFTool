// ui/tabs/editor_tab.slint

import {
    LineEdit,
    ComboBox,
    ListView,
    ScrollView,
    StandardListView,
    TextEdit,
    SpinBox,
} from "std-widgets.slint";
import { CustomButton } from "../components/buttons.slint";
import {
    SectionTitle,
    PanelSection,
    FormRow,
} from "../components/common.slint";

export struct GraphNodeData {
    id: int,
    title: string,
    subtitle: string,
    is_main: bool,
    x: length,
    y: length,
    width: length,
    height: length,
    record_index: int,
}

export struct GraphEdgeData {
    from_x: length,
    from_y: length,
    to_x: length,
    to_y: length,
}

component InspectorCell {
    in property <string> label: "";
    in-out property <string> value: "";
    in property <bool> read-only: false;

    VerticalLayout {
        spacing: 3px;
        Text {
            text: root.label;
            font-size: 11px;
            font-weight: 600;
            color: #949ba4;
            overflow: elide;
        }

        LineEdit {
            text <=> root.value;
            read-only: root.read-only;
            font-family: "Consolas";
            font-size: 11px;
            height: 28px;
        }
    }
}

export component EditorTab inherits HorizontalLayout {
    in-out property <length> sidebar_width: 460px;

    in-out property <string> editor_cff_dir: "";
    in-out property <string> editor_asset_source: "";
    in-out property <string> editor_filter: "";
    in-out property <string> editor_active_category: "2D Gfx Items (0x07DC)";
    in-out property <[string]> available_categories: [
        "2D Gfx Items (0x07DC)",
        "Spell Lines (0x0806)",
        "Spells Master (0x07D2)",
        "Tech Tree Upgrades (0x07F4)",
        "Items Master (0x07D3)",
        "Item Modifiers (0x07D4)",
        "Unit Stats (0x07D5)",
        "Weapon Stats (0x07DF)",
        "Spells Mapping (0x07E2)",
        "Races (0x07E6)",
        "Units Master (0x07E8)",
        "Buildings Master (0x07ED)",
        "Building Collision (0x07EE)",
        "Unit Loot Tables (0x07F8)",
        "Chest Loot Tables (0x0811)",
        "Level Progression (0x0800)",
        "Objects Master (0x0802)",
        "Object Collision (0x0809)",
        "Unit Equipment (0x07E9)",
        "Merchant Inventory (0x07FA)",
        "Quests (0x080D)",
        "Weapon Types (0x080F)",
        "Weapon Materials (0x0810)",
        "Item Sets (0x0818)",
        "Terrain Cultivation (0x07F0)",
        "Portals (0x0805)",
        "Descriptions (0x080A)",
        "Localized Strings"
    ];
    in-out property <string> editor_lang_filter: "All Languages";
    in-out property <[string]> available_languages: [
        "All Languages",
        "Slot 0: German [DE]",
        "Slot 1: English [EN]",
        "Slot 2: French [FR]",
        "Slot 3: Spanish [ES]",
        "Slot 4: Italian [IT]"
    ];
    in-out property <[StandardListViewItem]> editor_entries: [];
    in-out property <int> editor_selected_idx: -1;
    in-out property <string> editor_field_id: "";
    in-out property <string> editor_field_val1: "";
    in-out property <string> editor_field_val2: "";

    // 12-field contextual inspector properties
    in-out property <string> editor_field_p1: "";
    in-out property <string> editor_field_p2: "";
    in-out property <string> editor_field_p3: "";
    in-out property <string> editor_field_p4: "";
    in-out property <string> editor_field_p5: "";
    in-out property <string> editor_field_p6: "";
    in-out property <string> editor_field_p7: "";
    in-out property <string> editor_field_p8: "";
    in-out property <string> editor_field_p9: "";
    in-out property <string> editor_field_p10: "";
    in-out property <string> editor_field_p11: "";
    in-out property <string> editor_field_p12: "";

    in-out property <string> editor_label_p1: "";
    in-out property <string> editor_label_p2: "";
    in-out property <string> editor_label_p3: "";
    in-out property <string> editor_label_p4: "";
    in-out property <string> editor_label_p5: "";
    in-out property <string> editor_label_p6: "";
    in-out property <string> editor_label_p7: "";
    in-out property <string> editor_label_p8: "";
    in-out property <string> editor_label_p9: "";
    in-out property <string> editor_label_p10: "";
    in-out property <string> editor_label_p11: "";
    in-out property <string> editor_label_p12: "";

    // View Mode Switcher: 0 = Table List, 1 = UE5 Node Graph
    in-out property <int> editor_view_mode: 0;

    // Node Graph Properties
    in-out property <[GraphNodeData]> graph_nodes: [];
    in-out property <[GraphEdgeData]> graph_edges: [];
    in-out property <length> canvas_pan_x: 0px;
    in-out property <length> canvas_pan_y: 0px;
    in-out property <int> selected_node_id: -1;

    // Visual Previews & Dual Cards
    in-out property <image> preview_icon1;
    in-out property <image> preview_icon2;
    in-out property <string> spell_name_disp: "";
    in-out property <string> scroll_name_disp: "";
    in-out property <string> asset_status_text: "Select a record to preview asset.";

    // History Undo/Redo State
    in-out property <bool> can_undo: false;
    in-out property <bool> can_redo: false;

    // Clone Wizard Input State
    in-out property <int> clone_src_slot: 1;
    in-out property <int> clone_dst_slot: 6;
    in-out property <string> clone_lang_tag: "AR";

    callback browse_folder() -> string;
    callback browse_file(string) -> string;
    callback save_file(string) -> string;

    callback load_editor_data(string, string, string, string);
    callback select_editor_entry(int);
    callback save_editor_entry(string, string, int, [string]);
    callback add_editor_entry(string, string);
    callback duplicate_editor_entry(string, string, int, string);
    callback delete_editor_entry(string, string, int, string);

    callback load_quest_graph(string);

    // History Callbacks (Undo / Redo)
    callback editor_undo();
    callback editor_redo();

    // Unified Multi-Language Callbacks
    callback export_single_language(string, string, string);
    callback import_language_to_slot(string, string, string);
    callback execute_clone_language(string, int, int, string, string);

    spacing: 0px;

    // MODAL CLONE LANGUAGE POPUP
    clone_popup := PopupWindow {
        width: 380px;
        height: 250px;
        close-policy: close-on-click-outside;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        Rectangle {
            background: #232529;
            border-color: #f0b132;
            border-width: 1.5px;
            border-radius: 6px;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                Text {
                    text: "Clone Language Slot (One-Click Wizard)";
                    font-size: 13px;
                    font-weight: 700;
                    color: #ffffff;
                }

                Rectangle {
                    height: 1px;
                    background: #353535;
                }

                FormRow {
                    title: "Source Slot:";
                    label-width: 100px;
                    SpinBox {
                        value <=> root.clone_src_slot;
                        minimum: 0;
                        maximum: 4;
                        height: 28px;
                    }
                }

                FormRow {
                    title: "New Slot ID:";
                    label-width: 100px;
                    SpinBox {
                        value <=> root.clone_dst_slot;
                        minimum: 5;
                        maximum: 255;
                        height: 28px;
                    }
                }

                FormRow {
                    title: "Language Tag:";
                    label-width: 100px;
                    LineEdit {
                        text <=> root.clone_lang_tag;
                        placeholder-text: "e.g. AR, TH, RU, PL, ZH";
                        font-family: "Consolas";
                        height: 28px;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    CustomButton {
                        text: "Cancel";
                        primary-color: #4e5058;
                        clicked => { clone_popup.close(); }
                    }

                    CustomButton {
                        text: "Clone & Export JSON";
                        primary-color: #23a55a;
                        clicked => {
                            let out_json = root.save_file("json");
                            if (out_json != "") {
                                root.execute_clone_language(
                                    root.editor_cff_dir,
                                    root.clone_src_slot,
                                    root.clone_dst_slot,
                                    root.clone_lang_tag,
                                    out_json);
                                clone_popup.close();
                            }
                        }
                    }
                }
            }
        }
    }

    // LEFT PANEL: BROWSER, CONTROLS & DUAL-MODE VIEW
    Rectangle {
        width: root.sidebar_width;
        background: #2b2d31;
        border-color: #1f2023;
        border-width: 1px;
        border-radius: 4px;

        VerticalLayout {
            padding: 12px;
            spacing: 10px;

            PanelSection {
                title: "Target Database & Active Scope";
                title-color: #f0b132;
                VerticalLayout {
                    spacing: 6px;
                    FormRow {
                        title: "CFF Dir:";
                        HorizontalLayout {
                            spacing: 4px;
                            LineEdit {
                                text <=> root.editor_cff_dir;
                                placeholder-text: "Select extracted CFF folder...";
                                height: 28px;
                                font-family: "Consolas";
                                font-size: 11px;
                            }

                            CustomButton {
                                text: "...";
                                compact: true;
                                width: 30px;
                                height: 28px;
                                clicked => {
                                    let f = root.browse_folder();
                                    if (f != "") {
                                        root.editor_cff_dir = f;
                                        root.load_editor_data(root.editor_cff_dir, root.editor_active_category, root.editor_filter, root.editor_lang_filter);
                                    }
                                }
                            }
                        }
                    }

                    FormRow {
                        title: "Category:";
                        ComboBox {
                            model: root.available_categories;
                            current-value <=> root.editor_active_category;
                            height: 28px;
                            selected(cat) => {
                                root.editor_active_category = cat;
                                root.load_editor_data(root.editor_cff_dir, cat, root.editor_filter, root.editor_lang_filter);
                                if (cat == "Quests (0x080D)" && root.editor_view_mode == 1) {
                                    root.load_quest_graph(root.editor_cff_dir);
                                }
                            }
                        }
                    }

                    FormRow {
                        title: "Filter:";
                        LineEdit {
                            text <=> root.editor_filter;
                            placeholder-text: "Filter by ID, mesh or phrase...";
                            height: 28px;
                            font-family: "Consolas";
                            font-size: 11px;
                            edited => {
                                root.load_editor_data(root.editor_cff_dir, root.editor_active_category, root.editor_filter, root.editor_lang_filter);
                            }
                        }
                    }
                }
            }

            PanelSection {
                title: "View Modes & Records (" + root.editor_entries.length + " entries)";
                VerticalLayout {
                    spacing: 8px;
                    vertical-stretch: 1;

                    // MODE SWITCHER: Table vs Node Graph
                    HorizontalLayout {
                        spacing: 6px;
                        height: 28px;

                        CustomButton {
                            text: "📋 Table";
                            primary-color: root.editor_view_mode == 0 ? #3e6a90 : #232529;
                            clicked => { root.editor_view_mode = 0; }
                        }

                        CustomButton {
                            text: "🕸️ Node Graph (UE5)";
                            primary-color: root.editor_view_mode == 1 ? #8a5cf6 : #232529;
                            enabled: root.editor_active_category == "Quests (0x080D)";
                            clicked => {
                                root.editor_view_mode = 1;
                                root.load_quest_graph(root.editor_cff_dir);
                            }
                        }
                    }

                    // Action Controls: Add, Duplicate, Delete
                    HorizontalLayout {
                        spacing: 6px;
                        CustomButton {
                            text: "+ Add Entry";
                            primary-color: #23a55a;
                            enabled: root.editor_cff_dir != "";
                            clicked => {
                                root.add_editor_entry(root.editor_cff_dir, root.editor_active_category);
                            }
                        }

                        CustomButton {
                            text: "Duplicate";
                            primary-color: #e59535;
                            enabled: root.editor_selected_idx >= 0 && root.editor_cff_dir != "";
                            clicked => {
                                root.duplicate_editor_entry(
                                    root.editor_cff_dir,
                                    root.editor_active_category,
                                    root.editor_selected_idx,
                                    root.editor_field_id);
                            }
                        }

                        CustomButton {
                            text: "Delete";
                            primary-color: #aa3838;
                            enabled: root.editor_selected_idx >= 0 && root.editor_cff_dir != "";
                            clicked => {
                                root.delete_editor_entry(
                                    root.editor_cff_dir,
                                    root.editor_active_category,
                                    root.editor_selected_idx,
                                    root.editor_field_id);
                            }
                        }
                    }

                    // VIEW 0: Table List View
                    if root.editor_view_mode == 0: Rectangle {
                        background: #111214;
                        border-color: #1f2023;
                        border-width: 1px;
                        border-radius: 4px;
                        vertical-stretch: 1;
                        clip: true;

                        ListView {
                            for item[index] in root.editor_entries: Rectangle {
                                height: 26px;
                                background: ta_ed.has-hover ? #393c41 : (root.editor_selected_idx == index ? #2c3e50 : (Math.mod(index, 2) == 0 ? #191919 : #1c1c1c));
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: item.text;
                                        color: root.editor_selected_idx == index ? #f0b132 : #dcddde;
                                        font-family: "Consolas";
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                ta_ed := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.editor_selected_idx = index;
                                        root.select_editor_entry(index);
                                    }
                                }
                            }
                        }
                    }

                    // VIEW 1: Node Graph Canvas (Pan & Zoomable)
                    if root.editor_view_mode == 1: Rectangle {
                        background: #111214;
                        border-color: #8a5cf6;
                        border-width: 1.5px;
                        border-radius: 4px;
                        vertical-stretch: 1;
                        clip: true;

                        // Canvas Draggable Container
                        Rectangle {
                            x: root.canvas_pan_x;
                            y: root.canvas_pan_y;

                            // 1. Connection Cables (Elbow / Orthogonal Lines)
                            for edge in root.graph_edges: Rectangle {
                                // Horizontal 1
                                Rectangle {
                                    x: edge.from-x;
                                    y: edge.from-y - 1px;
                                    width: (edge.to-x - edge.from-x) / 2;
                                    height: 2px;
                                    background: #4e5058;
                                }
                                // Vertical
                                Rectangle {
                                    x: edge.from-x + (edge.to-x - edge.from-x) / 2;
                                    y: Math.min(edge.from-y, edge.to-y) - 1px;
                                    width: 2px;
                                    height: Math.abs(edge.to-y - edge.from-y) + 2px;
                                    background: #4e5058;
                                }
                                // Horizontal 2
                                Rectangle {
                                    x: edge.from-x + (edge.to-x - edge.from-x) / 2;
                                    y: edge.to-y - 1px;
                                    width: (edge.to-x - edge.from-x) / 2;
                                    height: 2px;
                                    background: #4e5058;
                                }
                            }

                            // 2. Interactive Node Cards
                            for node in root.graph_nodes: Rectangle {
                                x: node.x;
                                y: node.y;
                                width: node.width;
                                height: node.height;
                                background: #1e1f22;
                                border-radius: 6px;
                                border-width: root.selected_node_id == node.id ? 2px : 1px;
                                border-color: root.selected_node_id == node.id ? #f0b132 : (node.is_main ? #e59535 : #3e6a90);

                                VerticalLayout {
                                    // Colored Header Pin Bar
                                    Rectangle {
                                        height: 20px;
                                        background: node.is_main ? #995511 : #224466;
                                        border-top-left-radius: 5px;
                                        border-top-right-radius: 5px;

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            Text {
                                                text: (node.is_main ? "⭐ [MAIN] " : "🔷 [SIDE] ") + node.title;
                                                font-size: 10px;
                                                font-weight: 700;
                                                color: #ffffff;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }

                                    // Node Body
                                    VerticalLayout {
                                        padding: 6px;
                                        alignment: center;
                                        Text {
                                            text: node.subtitle;
                                            font-size: 9px;
                                            font-family: "Consolas";
                                            color: #cfcfcf;
                                            overflow: elide;
                                        }
                                    }
                                }

                                // Left Pin (Input)
                                Rectangle {
                                    x: -4px;
                                    y: (parent.height - self.height) / 2;
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: #3e6a90;
                                }

                                // Right Pin (Output)
                                Rectangle {
                                    x: parent.width - 4px;
                                    y: (parent.height - self.height) / 2;
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: #f0b132;
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.selected_node_id = node.id;
                                        root.editor_selected_idx = node.record_index;
                                        root.select_editor_entry(node.record_index);
                                    }
                                }
                            }
                        }

                        // Canvas Pan/Drag Area
                        TouchArea {
                            moved => {
                                if self.pressed {
                                    root.canvas_pan_x += self.mouse-x - self.pressed-x;
                                    root.canvas_pan_y += self.mouse-y - self.pressed-y;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // RESIZE SPLITTER
    Rectangle {
        width: 8px;
        background: splitter-ta.has-hover ? #474747 : #181818;

        Rectangle {
            width: 2px;
            height: 24px;
            background: #808080;
            border-radius: 1px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        splitter-ta := TouchArea {
            mouse-cursor: col-resize;
            moved => {
                if self.pressed {
                    root.sidebar_width = (root.sidebar_width + self.mouse-x - self.pressed-x).clamp(340px, 680px);
                }
            }
        }
    }

    // RIGHT PANEL: CONTEXTUAL INSPECTOR & SHOWCASE
    Rectangle {
        horizontal-stretch: 1;
        background: #2b2d31;
        border-color: #1f2023;
        border-width: 1px;
        border-radius: 4px;
        clip: true;

        ScrollView {
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                alignment: start;

                // Header with Undo / Redo / Discard Controls
                HorizontalLayout {
                    alignment: space-between;

                    SectionTitle {
                        text: "Entity Inspector & Live Showcase";
                        text-color: #f0b132;
                        width: 260px;
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: end;

                        CustomButton {
                            text: "↶ Undo";
                            compact: true;
                            width: 65px;
                            height: 24px;
                            primary-color: #4e5058;
                            enabled: root.can_undo;
                            clicked => { root.editor_undo(); }
                        }

                        CustomButton {
                            text: "↷ Redo";
                            compact: true;
                            width: 65px;
                            height: 24px;
                            primary-color: #4e5058;
                            enabled: root.can_redo;
                            clicked => { root.editor_redo(); }
                        }

                        CustomButton {
                            text: "↺ Discard";
                            compact: true;
                            width: 70px;
                            height: 24px;
                            primary-color: #353535;
                            enabled: root.editor_selected_idx >= 0;
                            clicked => {
                                root.select_editor_entry(root.editor_selected_idx);
                            }
                        }
                    }
                }

                // A. DUAL CARDS FOR SPELLS MAPPING (0x07E2)
                if root.editor_active_category == "Spells Mapping (0x07E2)": HorizontalLayout {
                    spacing: 12px;
                    alignment: center;
                    height: 125px;

                    Rectangle {
                        width: 180px;
                        background: #18191b;
                        border-color: #353535;
                        border-width: 1px;
                        border-radius: 6px;

                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;
                            alignment: center;

                            Rectangle {
                                width: 64px;
                                height: 64px;
                                background: #111214;
                                border-color: #e59535;
                                border-width: 1px;
                                border-radius: 4px;
                                clip: true;

                                Image {
                                    source: root.preview_icon1;
                                    width: 100%;
                                    height: 100%;
                                    image-fit: contain;
                                }
                            }

                            Text {
                                text: root.spell_name_disp != "" ? root.spell_name_disp : "Combat Spell";
                                font-size: 11px;
                                font-weight: 700;
                                color: #f0b132;
                                horizontal-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                text: "Spell ID: " + root.editor_field_id;
                                font-size: 10px;
                                color: #808080;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "➔";
                            font-size: 22px;
                            font-weight: 700;
                            color: #f0b132;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 180px;
                        background: #18191b;
                        border-color: #353535;
                        border-width: 1px;
                        border-radius: 6px;

                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;
                            alignment: center;

                            Rectangle {
                                width: 64px;
                                height: 64px;
                                background: #111214;
                                border-color: #3e6a90;
                                border-width: 1px;
                                border-radius: 4px;
                                clip: true;

                                Image {
                                    source: root.preview_icon2;
                                    width: 100%;
                                    height: 100%;
                                    image-fit: contain;
                                }
                            }

                            Text {
                                text: root.scroll_name_disp != "" ? root.scroll_name_disp : "Inventory Scroll";
                                font-size: 11px;
                                font-weight: 700;
                                color: #3e6a90;
                                horizontal-alignment: center;
                                overflow: elide;
                            }

                            Text {
                                text: "Scroll ID: " + root.editor_field_val1;
                                font-size: 10px;
                                color: #808080;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }

                // B. LIVE PREVIEW FOR ICONS, ASSETS & VECTOR POLYGONS
                if root.editor_active_category != "Spells Mapping (0x07E2)" && root.editor_active_category != "Localized Strings": HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    height: 84px;

                    Rectangle {
                        width: 84px;
                        height: 84px;
                        background: #111214;
                        border-color: #f0b132;
                        border-width: 1.5px;
                        border-radius: 6px;
                        clip: true;

                        Image {
                            source: root.preview_icon1;
                            width: 100%;
                            height: 100%;
                            image-fit: contain;
                        }
                    }

                    VerticalLayout {
                        spacing: 4px;
                        alignment: center;

                        Text {
                            text: root.editor_active_category;
                            font-size: 12px;
                            font-weight: 700;
                            color: #f0b132;
                        }

                        Text {
                            text: root.asset_status_text;
                            font-size: 11px;
                            font-family: "Consolas";
                            color: #dcddde;
                            wrap: word-wrap;
                        }
                    }
                }

                Rectangle {
                    height: 1px;
                    background: #353535;
                }

                // PRIMARY RECORD KEY / ID
                FormRow {
                    title: "Record Key / ID:";
                    label-width: 130px;
                    LineEdit {
                        text <=> root.editor_field_id;
                        read-only: true;
                        font-family: "Consolas";
                        height: 28px;
                    }
                }

                // VIEW A: MULTILINE LOCALIZED STRING EDITOR
                if root.editor_active_category == "Localized Strings": VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: "Localized Phrase Content:";
                        font-size: 11px;
                        color: #dcddde;
                        font-weight: 600;
                    }

                    TextEdit {
                        text <=> root.editor_field_val1;
                        font-family: "Consolas";
                        font-size: 12px;
                        height: 180px;
                        wrap: TextWrap.word-wrap;
                    }

                    Text {
                        text: root.editor_field_val2;
                        font-family: "Consolas";
                        font-size: 11px;
                        color: #808080;
                    }
                }

                // VIEW B: DYNAMIC TWO-COLUMN STRUCTURED INSPECTOR (P1..P12)
                if root.editor_active_category != "Localized Strings": HorizontalLayout {
                    spacing: 12px;

                    // Column 1 (Odds: P1, P3, P5, P7, P9, P11)
                    VerticalLayout {
                        spacing: 8px;
                        horizontal-stretch: 1;

                        if root.editor_label_p1 != "": InspectorCell {
                            label: root.editor_label_p1;
                            value <=> root.editor_field_p1;
                        }

                        if root.editor_label_p3 != "": InspectorCell {
                            label: root.editor_label_p3;
                            value <=> root.editor_field_p3;
                        }

                        if root.editor_label_p5 != "": InspectorCell {
                            label: root.editor_label_p5;
                            value <=> root.editor_field_p5;
                        }

                        if root.editor_label_p7 != "": InspectorCell {
                            label: root.editor_label_p7;
                            value <=> root.editor_field_p7;
                            read-only: root.editor_active_category == "Unit Loot Tables (0x07F8)" || root.editor_active_category == "Chest Loot Tables (0x0811)";
                        }

                        if root.editor_label_p9 != "": InspectorCell {
                            label: root.editor_label_p9;
                            value <=> root.editor_field_p9;
                            read-only: root.editor_active_category == "Unit Loot Tables (0x07F8)" || root.editor_active_category == "Chest Loot Tables (0x0811)";
                        }

                        if root.editor_label_p11 != "": InspectorCell {
                            label: root.editor_label_p11;
                            value <=> root.editor_field_p11;
                        }
                    }

                    // Column 2 (Evens: P2, P4, P6, P8, P10, P12)
                    VerticalLayout {
                        spacing: 8px;
                        horizontal-stretch: 1;

                        if root.editor_label_p2 != "": InspectorCell {
                            label: root.editor_label_p2;
                            value <=> root.editor_field_p2;
                        }

                        if root.editor_label_p4 != "": InspectorCell {
                            label: root.editor_label_p4;
                            value <=> root.editor_field_p4;
                            read-only: root.editor_active_category == "Weapon Stats (0x07DF)";
                        }

                        if root.editor_label_p6 != "": InspectorCell {
                            label: root.editor_label_p6;
                            value <=> root.editor_field_p6;
                        }

                        if root.editor_label_p8 != "": InspectorCell {
                            label: root.editor_label_p8;
                            value <=> root.editor_field_p8;
                            read-only: root.editor_active_category == "Unit Loot Tables (0x07F8)" || root.editor_active_category == "Chest Loot Tables (0x0811)";
                        }

                        if root.editor_label_p10 != "": InspectorCell {
                            label: root.editor_label_p10;
                            value <=> root.editor_field_p10;
                        }

                        if root.editor_label_p12 != "": InspectorCell {
                            label: root.editor_label_p12;
                            value <=> root.editor_field_p12;
                        }
                    }
                }

                CustomButton {
                    text: "Save Record Changes to Chunk (.dat)";
                    enabled: root.editor_selected_idx >= 0 && root.editor_cff_dir != "" && root.editor_active_category != "Object Collision (0x0809)" && root.editor_active_category != "Building Collision (0x07EE)";
                    primary-color: #23a55a;
                    height: 32px;
                    clicked => {
                        root.save_editor_entry(
                            root.editor_cff_dir,
                            root.editor_active_category,
                            root.editor_selected_idx,
                            [
                            root.editor_field_id,
                            root.editor_field_p1,
                            root.editor_field_p2,
                            root.editor_field_p3,
                            root.editor_field_p4,
                            root.editor_field_p5,
                            root.editor_field_p6,
                            root.editor_field_p7,
                            root.editor_field_p8,
                            root.editor_field_p9,
                            root.editor_field_p10,
                            root.editor_field_p11,
                            root.editor_field_p12,
                            root.editor_field_val1
                        ]);
                    }
                }

                Rectangle {
                    height: 1px;
                    background: #353535;
                }

                Text {
                    text: "Structured Studio Inspector Guide:\n" +
                        "• Node Graph Navigation: Switch between 📋 Table and 🕸️ Node Graph for visual branching.\n" +
                        "• Pan & Drag Canvas: Hold and drag anywhere on the canvas to explore large quest trees.\n" +
                        "• Click to Inspect: Selecting any node instantly loads its parameters into this inspector.\n" +
                        "• ↶ Undo / ↷ Redo: Safely revert or reapply changes made during the current editing session.";
                    color: #808080;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
        }
    }
}
