// ui/tabs/inspector_tab.slint

import {
    LineEdit,
    ComboBox,
    ListView,
    ScrollView,
    StandardListView,
} from "std-widgets.slint";
import { CustomButton } from "../components/buttons.slint";
import {
    SectionTitle,
    PanelSection,
    FormRow,
} from "../components/common.slint";

export component InspectorTab inherits HorizontalLayout {
    in-out property <length> sidebar_width: 420px;

    in-out property <string> selected_dat: "";
    in-out property <string> filter_text: "";
    in-out property <string> inspector_target_offset: "0";
    in-out property <string> inspector_base_offset: "0";
    in-out property <string> inspector_current_val: "No Data";
    in-out property <[StandardListViewItem]> inspector_results: [];

    callback browse_file(string) -> string;
    callback scan_binary(string, string);
    callback read_value(string, string, string) -> string;
    callback write_value(string, string, string, string);
    callback inspector_select_row(int);

    spacing: 0px;

    Rectangle {
        width: root.sidebar_width;
        background: #2b2d31;
        border-color: #1f2023;
        border-width: 1px;
        border-radius: 4px;

        ScrollView {
            VerticalLayout {
                padding: 12px;
                spacing: 12px;
                alignment: start;

                PanelSection {
                    title: "Binary Chunk Scanner";
                    VerticalLayout {
                        spacing: 6px;
                        FormRow {
                            title: "DAT Chunk:";
                            HorizontalLayout {
                                spacing: 4px;
                                LineEdit {
                                    text <=> root.selected_dat;
                                    placeholder-text: "Path to .dat chunk...";
                                    height: 28px;
                                    font-family: "Consolas";
                                    font-size: 11px;
                                }

                                CustomButton {
                                    text: "...";
                                    compact: true;
                                    width: 30px;
                                    height: 28px;
                                    clicked => { root.selected_dat = root.browse_file("dat"); }
                                }
                            }
                        }

                        FormRow {
                            title: "Filter:";
                            LineEdit {
                                text <=> root.filter_text;
                                placeholder-text: "Case-insensitive string...";
                                height: 28px;
                                font-family: "Consolas";
                                font-size: 11px;
                            }
                        }

                        CustomButton {
                            text: "Scan Strings (ASCII & ANSI)";
                            enabled: root.selected_dat != "";
                            primary-color: #3e6a90;
                            clicked => { root.scan_binary(root.selected_dat, root.filter_text); }
                        }
                    }
                }

                PanelSection {
                    title: "Scanned Strings (Click to Inspect Offset)";
                    Rectangle {
                        height: 320px;
                        background: #111214;
                        border-color: #1f2023;
                        border-width: 1px;
                        border-radius: 4px;
                        clip: true;

                        ListView {
                            for item[index] in root.inspector_results: Rectangle {
                                height: 24px;
                                background: ta_scan.has-hover ? #393c41 : (Math.mod(index, 2) == 0 ? #191919 : #1c1c1c);
                                HorizontalLayout {
                                    padding-left: 8px;
                                    Text {
                                        text: item.text;
                                        color: #dcddde;
                                        font-family: "Consolas";
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }

                                ta_scan := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.inspector_select_row(index); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    Rectangle {
        width: 8px;
        background: splitter-ta.has-hover ? #474747 : #181818;

        Rectangle {
            width: 2px;
            height: 24px;
            background: #808080;
            border-radius: 1px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        splitter-ta := TouchArea {
            mouse-cursor: col-resize;
            moved => {
                if self.pressed {
                    root.sidebar_width = (root.sidebar_width + self.mouse-x - self.pressed-x).clamp(340px, 680px);
                }
            }
        }
    }

    Rectangle {
        horizontal-stretch: 1;
        background: #2b2d31;
        border-color: #1f2023;
        border-width: 1px;
        border-radius: 4px;
        clip: true;

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

            SectionTitle {
                text: "Low-Level Value Modifier & Offset Calculator";
            }

            FormRow {
                title: "Target Offset:";
                label-width: 110px;
                offset_in := LineEdit {
                    text <=> root.inspector_target_offset;
                    font-family: "Consolas";
                    height: 28px;
                }
            }

            FormRow {
                title: "Data Type:";
                label-width: 110px;
                type_in := ComboBox {
                    model: ["Byte", "Int16", "Int32", "Float32", "String"];
                    current-value: "Int16";
                    height: 28px;
                }
            }

            CustomButton {
                text: "Read Value from File";
                enabled: root.selected_dat != "";
                primary-color: #3e6a90;
                clicked => {
                    current_val.text = root.read_value(root.selected_dat, offset_in.text, type_in.current-value);
                }
            }

            FormRow {
                title: "Current Value:";
                label-width: 110px;
                current_val := LineEdit {
                    text <=> root.inspector_current_val;
                    read-only: true;
                    font-family: "Consolas";
                    height: 28px;
                }
            }

            FormRow {
                title: "New Value:";
                label-width: 110px;
                new_val := LineEdit {
                    font-family: "Consolas";
                    height: 28px;
                }
            }

            CustomButton {
                text: "Write Value to Binary Chunk";
                enabled: root.selected_dat != "";
                primary-color: #aa3838;
                clicked => {
                    root.write_value(root.selected_dat, offset_in.text, type_in.current-value, new_val.text);
                    current_val.text = root.read_value(root.selected_dat, offset_in.text, type_in.current-value);
                }
            }

            Rectangle {
                vertical-stretch: 1;
            }
        }
    }
}
