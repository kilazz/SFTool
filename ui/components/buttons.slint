// ui/components/buttons.slint

export component TabButton {
    in property <string> text;
    in property <bool> active: false;
    in property <color> accent-color: #e59535;
    callback clicked;

    width: 140px;
    height: 30px;

    rect := Rectangle {
        background: root.active ? #2b2d31 : (ta.has-hover ? #242629 : #18191b);
        border-color: root.active ? #353535 : (ta.has-hover ? #2e3035 : #1f2023);
        border-width: 1px;
        border-radius: 4px;

        animate background { duration: 100ms; }
        animate border-color { duration: 100ms; }

        HorizontalLayout {
            alignment: center;
            spacing: 6px;

            if root.active: Rectangle {
                width: 4px;
                height: 4px;
                border-radius: 2px;
                background: root.accent-color;
                y: (parent.height - self.height) / 2;
            }

            txt := Text {
                text: root.text;
                color: root.active ? #ffffff : (ta.has-hover ? #dcddde : #808080);
                font-size: 12px;
                font-weight: root.active ? 700 : 500;
                vertical-alignment: center;
                animate color { duration: 100ms; }
            }
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component CustomButton {
    in property <string> text;
    in property <bool> enabled: true;
    in property <color> primary-color: #3e6a90;
    in property <bool> compact: false;
    callback clicked;

    height: 28px;
    min-width: compact ? self.height : 90px;

    rect := Rectangle {
        background: !root.enabled ? #202124 : (ta.pressed ? root.primary-color.darker(15%) : (ta.has-hover ? root.primary-color.brighter(12%) : root.primary-color));
        border-radius: 4px;
        border-width: 1px;
        border-color: !root.enabled ? #2b2d31 : root.primary-color.darker(10%);
        opacity: !root.enabled ? 0.45 : 1.0;

        animate background { duration: 90ms; }

        HorizontalLayout {
            alignment: center;
            padding-left: compact ? 4px : 12px;
            padding-right: compact ? 4px : 12px;

            Text {
                text: root.text;
                color: !root.enabled ? #808080 : #ffffff;
                font-size: 11px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}
