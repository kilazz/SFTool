// ui/app.slint

import { StandardListView } from "std-widgets.slint";

// IMPORT COMPONENTS
import { TabButton } from "./components/buttons.slint";

// IMPORT MODULAR TABS
import { PakTab } from "./tabs/pak_tab.slint";
import { CffTab } from "./tabs/cff_tab.slint";
import {
    EditorTab,
    GraphNodeData,
    GraphEdgeData,
} from "./tabs/editor_tab.slint";
import { LuaTab } from "./tabs/lua_tab.slint";
import { LogTab } from "./tabs/log_tab.slint";

export component AppWindow inherits Window {
    title: "SFTool v2.2 - SpellForce Modding & Balance Studio";
    min-width: 1100px;
    min-height: 760px;
    preferred-width: 1280px;
    preferred-height: 840px;
    background: #181818;

    in-out property <int> active_tab: 0;

    // --- Dynamic Sidebar Resizing (PAK / CFF / Lua) ---
    in-out property <length> sidebar_width: 420px;

    // --- Dynamic Column Resizing (Database Studio) ---
    in-out property <length> col1_width: 210px;
    in-out property <length> col2_width: 270px;
    in-out property <length> col4_width: 360px;

    // --- PAK State ---
    in-out property <string> selected_pak: "";
    in-out property <string> selected_folder: "";
    in-out property <string> persisted_pak_fmt: "SpellForce 1 (.pak)";
    in-out property <string> persisted_pak_algo: "Zlib";
    in-out property <int> persisted_pak_comp: 6;
    in-out property <[StandardListViewItem]> archive_files: [];

    // --- CFF State ---
    in-out property <string> selected_cff: "";
    in-out property <string> selected_cff_dir: "";
    in-out property <int> persisted_cff_comp: 6;

    // --- Database Studio State ---
    in-out property <string> editor_cff_dir: "";
    in-out property <string> editor_asset_source: "";
    in-out property <string> editor_filter: "";
    in-out property <string> editor_active_category: "2D Gfx Items (0x07DC)";
    in-out property <[string]> available_categories: [
        "2D Gfx Items (0x07DC)",
        "Spell Lines (0x0806)",
        "Spells Master (0x07D2)",
        "Tech Tree Upgrades (0x07F4)",
        "Items Master (0x07D3)",
        "Item Modifiers (0x07D4)",
        "Unit Stats (0x07D5)",
        "Weapon Stats (0x07DF)",
        "Spells Mapping (0x07E2)",
        "Races (0x07E6)",
        "Units Master (0x07E8)",
        "Buildings Master (0x07ED)",
        "Building Collision (0x07EE)",
        "Unit Loot Tables (0x07F8)",
        "Chest Loot Tables (0x0811)",
        "Level Progression (0x0800)",
        "Objects Master (0x0802)",
        "Object Collision (0x0809)",
        "Unit Equipment (0x07E9)",
        "Merchant Inventory (0x07FA)",
        "Quests (0x080D)",
        "Weapon Types (0x080F)",
        "Weapon Materials (0x0810)",
        "Item Sets (0x0818)",
        "Terrain Cultivation (0x07F0)",
        "Portals (0x0805)",
        "Descriptions (0x080A)",
        "Localized Strings"
    ];
    in-out property <string> editor_lang_filter: "All Languages";
    in-out property <[string]> available_languages: [
        "All Languages",
        "Slot 0: German [DE]",
        "Slot 1: English [EN]",
        "Slot 2: French [FR]",
        "Slot 3: Spanish [ES]",
        "Slot 4: Italian [IT]"
    ];
    in-out property <[StandardListViewItem]> editor_entries: [];
    in-out property <int> editor_selected_idx: -1;
    in-out property <string> editor_field_id: "";
    in-out property <string> editor_field_val1: "";
    in-out property <string> editor_field_val2: "";

    // Contextual 12-field structured inspector properties
    in-out property <string> editor_field_p1: "";
    in-out property <string> editor_field_p2: "";
    in-out property <string> editor_field_p3: "";
    in-out property <string> editor_field_p4: "";
    in-out property <string> editor_field_p5: "";
    in-out property <string> editor_field_p6: "";
    in-out property <string> editor_field_p7: "";
    in-out property <string> editor_field_p8: "";
    in-out property <string> editor_field_p9: "";
    in-out property <string> editor_field_p10: "";
    in-out property <string> editor_field_p11: "";
    in-out property <string> editor_field_p12: "";

    in-out property <string> editor_label_p1: "";
    in-out property <string> editor_label_p2: "";
    in-out property <string> editor_label_p3: "";
    in-out property <string> editor_label_p4: "";
    in-out property <string> editor_label_p5: "";
    in-out property <string> editor_label_p6: "";
    in-out property <string> editor_label_p7: "";
    in-out property <string> editor_label_p8: "";
    in-out property <string> editor_label_p9: "";
    in-out property <string> editor_label_p10: "";
    in-out property <string> editor_label_p11: "";
    in-out property <string> editor_label_p12: "";

    // Pagination properties
    in-out property <int> current_page: 1;
    in-out property <int> total_pages: 1;
    in-out property <string> page_info: "Page 1 of 1 (0 records)";

    // Visual Canvas & Interactive Node Graph State
    in-out property <[GraphNodeData]> graph_nodes: [];
    in-out property <[GraphEdgeData]> graph_edges: [];
    in-out property <length> canvas_pan_x: 40px;
    in-out property <length> canvas_pan_y: 40px;
    in-out property <int> selected_node_id: -1;

    // Visual Previews & Dual Cards
    in-out property <image> preview_icon1;
    in-out property <image> preview_icon2;
    in-out property <string> spell_name_disp: "";
    in-out property <string> scroll_name_disp: "";
    in-out property <string> asset_status_text: "Select a record to preview asset.";

    // History Undo/Redo States
    in-out property <bool> can_undo: false;
    in-out property <bool> can_redo: false;

    // --- Lua State ---
    in-out property <string> lua_engine_mode: "SpellForce 1 (Lua 4.0)";
    in-out property <string> lua_src_dir: "";
    in-out property <string> lua_out_dir: "";
    in-out property <string> luadec_path: "luadec_32_deb.exe";
    in-out property <string> luac_path: "luac4.exe";
    in-out property <bool> lua_resume: true;

    // --- Lua SF1 SQL Visual Bindings State & Undo/Redo ---
    in-out property <string> sql_file_path: "";
    in-out property <string> sql_file_type: "sql_item.lua";
    in-out property <[StandardListViewItem]> sql_entries: [];
    in-out property <int> sql_selected_idx: -1;
    in-out property <string> sql_field_id: "";
    in-out property <string> sql_field_val1: "";
    in-out property <string> sql_field_val2: "";
    in-out property <string> sql_field_val3: "";
    in-out property <string> sql_field_val4: "";
    in-out property <string> sql_label_val1: "Male Cold Mesh:";
    in-out property <string> sql_label_val2: "Female Cold Mesh:";
    in-out property <string> sql_label_val3: "AnimSet:";
    in-out property <string> sql_label_val4: "Selection Size:";
    in-out property <bool> can_sql_undo: false;
    in-out property <bool> can_sql_redo: false;

    // --- Lua SF2 API Explorer State ---
    in-out property <[StandardListViewItem]> api_list: [];
    in-out property <string> selected_fn_name: "";
    in-out property <string> selected_fn_snippet: "";
    in-out property <string> selected_fn_desc: "";

    // --- System / Terminal Logs ---
    in-out property <string> log_text: "System Ready.\n";
    in-out property <string> status_msg: "Ready.";

    // Callbacks: File Dialogs
    callback browse_file(string) -> string;
    callback browse_folder() -> string;
    callback save_file(string) -> string;

    // Callbacks: PAK & VFS Tree
    callback unpack_pak(string, string);
    callback pack_pak(string, string, string, string, int);
    callback batch_unpack_pak(string);
    callback batch_pack_pak(string, string, string, int);
    callback archive_item_clicked(int);
    callback load_archive_tree(string);

    // Callbacks: CFF & Integrity Audit
    callback unpack_cff(string, string);
    callback pack_cff(string, string, int);
    callback audit_cff_coverage(string);
    callback create_cff_diff(string, string, string);
    callback apply_cff_patch(string, string);

    // Callbacks: Database Studio & Visual Canvas
    callback load_editor_data(string, string, string, string);
    callback change_page(string, string, string, string, int);
    callback select_editor_entry(int);
    callback save_editor_entry(string, string, int, [string]);
    callback add_editor_entry(string, string);
    callback duplicate_editor_entry(string, string, int, string);
    callback delete_editor_entry(string, string, int, string);
    callback load_quest_graph(string);
    callback editor_undo();
    callback editor_redo();
    callback export_single_language(string, string, string);
    callback import_language_to_slot(string, string, string);
    callback execute_clone_language(string, int, int, string, string);

    // Callbacks: Lua Core (SF1)
    callback decompile_lua(string, string, string, bool);
    callback check_lua_syntax(string, string);
    callback format_lua_scripts(string, bool);

    // Callbacks: SpellForce 1 SQL Lua
    callback load_sql_file(string, string);
    callback select_sql_entry(int);
    callback save_sql_entry(int, string, string, string, string);
    callback write_sql_file(string, string);
    callback sql_undo();
    callback sql_redo();

    // Callbacks: Lua Core (SF2)
    callback check_lua_syntax_sf2(string, string);
    callback format_lua_stylua(string, string, bool);
    callback search_api_query(string, string);
    callback select_api_entry(int);
    callback copy_snippet_to_clipboard(string);
    callback create_map_project(string, string, string);
    callback export_emmylua_defs(string);

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        // TOP NAVIGATION TABS
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            height: 32px;

            TabButton {
                text: "PAK Archive";
                active: root.active_tab == 0;
                accent-color: #3e6a90;
                clicked => { root.active_tab = 0; }
            }

            TabButton {
                text: "CFF Database";
                active: root.active_tab == 1;
                accent-color: #23a55a;
                clicked => { root.active_tab = 1; }
            }

            TabButton {
                text: "Database Studio";
                active: root.active_tab == 2;
                accent-color: #f0b132;
                clicked => { root.active_tab = 2; }
            }

            TabButton {
                text: "Lua Scripts";
                active: root.active_tab == 3;
                accent-color: #8a5cf6;
                clicked => { root.active_tab = 3; }
            }

            TabButton {
                text: "Terminal Log";
                active: root.active_tab == 4;
                accent-color: #e59535;
                clicked => { root.active_tab = 4; }
            }

            Rectangle {
                horizontal-stretch: 1;
            }
        }

        // DYNAMIC CONTENT VIEWPORTS
        Rectangle {
            vertical-stretch: 1;
            horizontal-stretch: 1;

            if root.active_tab == 0: PakTab {
                sidebar_width <=> root.sidebar_width;
                selected_pak <=> root.selected_pak;
                selected_folder <=> root.selected_folder;
                persisted_pak_fmt <=> root.persisted_pak_fmt;
                persisted_pak_algo <=> root.persisted_pak_algo;
                persisted_pak_comp <=> root.persisted_pak_comp;
                archive_files: root.archive_files;

                browse_file(ext) => { root.browse_file(ext) }
                browse_folder => { root.browse_folder() }
                save_file(ext) => { root.save_file(ext) }
                unpack_pak(p, out) => { root.unpack_pak(p, out) }
                pack_pak(src, out, fmt, algo, comp) => { root.pack_pak(src, out, fmt, algo, comp) }
                batch_unpack_pak(f) => { root.batch_unpack_pak(f) }
                batch_pack_pak(f, fmt, algo, comp) => { root.batch_pack_pak(f, fmt, algo, comp) }
                archive_item_clicked(idx) => { root.archive_item_clicked(idx) }
                load_archive_tree(p) => { root.load_archive_tree(p) }
            }

            if root.active_tab == 1: CffTab {
                sidebar_width <=> root.sidebar_width;
                selected_cff <=> root.selected_cff;
                selected_cff_dir <=> root.selected_cff_dir;
                persisted_cff_comp <=> root.persisted_cff_comp;
                archive_files: root.archive_files;

                browse_file(ext) => { root.browse_file(ext) }
                browse_folder => { root.browse_folder() }
                save_file(ext) => { root.save_file(ext) }
                unpack_cff(cff, out) => { root.unpack_cff(cff, out) }
                pack_cff(dir, out, comp) => { root.pack_cff(dir, out, comp) }
                audit_cff_coverage(d) => { root.audit_cff_coverage(d) }
                create_cff_diff(b, m, p) => { root.create_cff_diff(b, m, p) }
                apply_cff_patch(t, p) => { root.apply_cff_patch(t, p) }
                archive_item_clicked(idx) => { root.archive_item_clicked(idx) }
                load_archive_tree(p) => { root.load_archive_tree(p) }
            }

            if root.active_tab == 2: EditorTab {
                col1_width <=> root.col1_width;
                col2_width <=> root.col2_width;
                col4_width <=> root.col4_width;

                editor_cff_dir <=> root.editor_cff_dir;
                editor_asset_source <=> root.editor_asset_source;
                editor_filter <=> root.editor_filter;
                editor_active_category <=> root.editor_active_category;
                available_categories <=> root.available_categories;
                editor_lang_filter <=> root.editor_lang_filter;
                available_languages <=> root.available_languages;
                editor_entries: root.editor_entries;
                editor_selected_idx <=> root.editor_selected_idx;
                editor_field_id <=> root.editor_field_id;
                editor_field_val1 <=> root.editor_field_val1;
                editor_field_val2 <=> root.editor_field_val2;

                editor_field_p1 <=> root.editor_field_p1;
                editor_field_p2 <=> root.editor_field_p2;
                editor_field_p3 <=> root.editor_field_p3;
                editor_field_p4 <=> root.editor_field_p4;
                editor_field_p5 <=> root.editor_field_p5;
                editor_field_p6 <=> root.editor_field_p6;
                editor_field_p7 <=> root.editor_field_p7;
                editor_field_p8 <=> root.editor_field_p8;
                editor_field_p9 <=> root.editor_field_p9;
                editor_field_p10 <=> root.editor_field_p10;
                editor_field_p11 <=> root.editor_field_p11;
                editor_field_p12 <=> root.editor_field_p12;

                editor_label_p1 <=> root.editor_label_p1;
                editor_label_p2 <=> root.editor_label_p2;
                editor_label_p3 <=> root.editor_label_p3;
                editor_label_p4 <=> root.editor_label_p4;
                editor_label_p5 <=> root.editor_label_p5;
                editor_label_p6 <=> root.editor_label_p6;
                editor_label_p7 <=> root.editor_label_p7;
                editor_label_p8 <=> root.editor_label_p8;
                editor_label_p9 <=> root.editor_label_p9;
                editor_label_p10 <=> root.editor_label_p10;
                editor_label_p11 <=> root.editor_label_p11;
                editor_label_p12 <=> root.editor_label_p12;

                current_page <=> root.current_page;
                total_pages <=> root.total_pages;
                page_info <=> root.page_info;

                graph_nodes <=> root.graph_nodes;
                graph_edges <=> root.graph_edges;
                canvas_pan_x <=> root.canvas_pan_x;
                canvas_pan_y <=> root.canvas_pan_y;
                selected_node_id <=> root.selected_node_id;

                preview_icon1 <=> root.preview_icon1;
                preview_icon2 <=> root.preview_icon2;
                spell_name_disp <=> root.spell_name_disp;
                scroll_name_disp <=> root.scroll_name_disp;
                asset_status_text <=> root.asset_status_text;
                can_undo: root.can_undo;
                can_redo: root.can_redo;

                browse_folder => { root.browse_folder() }
                browse_file(ext) => { root.browse_file(ext) }
                save_file(ext) => { root.save_file(ext) }
                load_editor_data(dir, cat, flt, lang) => { root.load_editor_data(dir, cat, flt, lang) }
                change_page(dir, cat, flt, lang, p) => { root.change_page(dir, cat, flt, lang, p) }
                select_editor_entry(idx) => { root.select_editor_entry(idx) }
                save_editor_entry(dir, cat, idx, fields) => { root.save_editor_entry(dir, cat, idx, fields) }
                add_editor_entry(dir, cat) => { root.add_editor_entry(dir, cat) }
                duplicate_editor_entry(dir, cat, idx, id) => { root.duplicate_editor_entry(dir, cat, idx, id) }
                delete_editor_entry(dir, cat, idx, id) => { root.delete_editor_entry(dir, cat, idx, id) }
                load_quest_graph(dir) => { root.load_quest_graph(dir) }
                editor_undo => { root.editor_undo() }
                editor_redo => { root.editor_redo() }
                export_single_language(dir, lang, out) => { root.export_single_language(dir, lang, out) }
                import_language_to_slot(dir, lang, file) => { root.import_language_to_slot(dir, lang, file) }
                execute_clone_language(dir, src, dst, tag, out) => { root.execute_clone_language(dir, src, dst, tag, out) }
            }

            if root.active_tab == 3: LuaTab {
                sidebar_width <=> root.sidebar_width;
                lua_engine_mode <=> root.lua_engine_mode;
                lua_src_dir <=> root.lua_src_dir;
                lua_out_dir <=> root.lua_out_dir;
                luadec_path <=> root.luadec_path;
                luac_path <=> root.luac_path;
                lua_resume <=> root.lua_resume;

                sql_file_path <=> root.sql_file_path;
                sql_file_type <=> root.sql_file_type;
                sql_entries: root.sql_entries;
                sql_selected_idx <=> root.sql_selected_idx;
                sql_field_id <=> root.sql_field_id;
                sql_field_val1 <=> root.sql_field_val1;
                sql_field_val2 <=> root.sql_field_val2;
                sql_field_val3 <=> root.sql_field_val3;
                sql_field_val4 <=> root.sql_field_val4;
                sql_label_val1 <=> root.sql_label_val1;
                sql_label_val2 <=> root.sql_label_val2;
                sql_label_val3 <=> root.sql_label_val3;
                sql_label_val4 <=> root.sql_label_val4;
                can_sql_undo: root.can_sql_undo;
                can_sql_redo: root.can_sql_redo;

                api_list: root.api_list;
                selected_fn_name <=> root.selected_fn_name;
                selected_fn_snippet <=> root.selected_fn_snippet;
                selected_fn_desc <=> root.selected_fn_desc;

                browse_folder => { root.browse_folder() }
                browse_file(ext) => { root.browse_file(ext) }
                save_file(ext) => { root.save_file(ext) }
                decompile_lua(s, d, exe, res) => { root.decompile_lua(s, d, exe, res) }
                check_lua_syntax(s, exe) => { root.check_lua_syntax(s, exe) }
                format_lua_scripts(s, tabs) => { root.format_lua_scripts(s, tabs) }

                load_sql_file(fp, ft) => { root.load_sql_file(fp, ft) }
                select_sql_entry(idx) => { root.select_sql_entry(idx) }
                save_sql_entry(idx, v1, v2, v3, v4) => { root.save_sql_entry(idx, v1, v2, v3, v4) }
                write_sql_file(fp, ft) => { root.write_sql_file(fp, ft) }
                sql_undo => { root.sql_undo() }
                sql_redo => { root.sql_redo() }

                check_lua_syntax_sf2(s, exe) => { root.check_lua_syntax_sf2(s, exe) }
                format_lua_stylua(s, exe, tabs) => { root.format_lua_stylua(s, exe, tabs) }
                search_api_query(q, c) => { root.search_api_query(q, c) }
                select_api_entry(idx) => { root.select_api_entry(idx) }
                copy_snippet_to_clipboard(s) => { root.copy_snippet_to_clipboard(s) }
                create_map_project(dest, p, m) => { root.create_map_project(dest, p, m) }
                export_emmylua_defs(dest) => { root.export_emmylua_defs(dest) }
            }

            if root.active_tab == 4: LogTab {
                log_text: root.log_text;
            }
        }

        // FIXED BOTTOM STATUS BAR
        Rectangle {
            height: 32px;
            background: #2b2d31;
            border-color: #1f2023;
            border-width: 1px;
            border-radius: 4px;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 10px;

                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: #23a55a;
                    y: (parent.height - self.height) / 2;
                }

                Text {
                    text: root.status_msg;
                    color: #cfcfcf;
                    font-size: 12px;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                Text {
                    text: "SFTool v2.2";
                    color: #808080;
                    font-size: 11px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }
    }
}
